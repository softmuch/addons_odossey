<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_claude_ocr" model="ir.ui.view">
        <field name="name">account.move.form.claude.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="action_reload_imported_data" position="after">
                <button name="action_claude_digitize"
                        string="Digitize with Claude"
                        type="object"
                        groups="account.group_account_invoice"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"/>
            </button>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit_claude_ocr" model="ir.ui.view">
        <field name="name">account.move.in.invoice.list.claude.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(odossey_invoice_claude_ocr.action_claude_invoice_wizard)d"
                        string="Digitize with Claude"
                        type="action"
                        display="always"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

</odoo>
