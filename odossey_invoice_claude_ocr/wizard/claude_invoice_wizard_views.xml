<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="claude_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">claude.invoice.wizard.form</field>
        <field name="model">claude.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Digitize with Claude">
                <field name="state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="mimetype" invisible="1"/>
                <field name="is_pdf" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <field name="unmapped_pending_count" invisible="1"/>
                <field name="totals_mismatch" invisible="1"/>
                <field name="has_existing_lines" invisible="1"/>

                <!-- STEP 1: upload -->
                <div invisible="state != 'upload'">
                    <p class="text-muted">
                        Upload the vendor bill (PDF, JPG, PNG, WEBP or GIF). Claude will read it and
                        propose every value on its field so you can review it before creating the draft bill.
                    </p>
                    <group>
                        <group>
                            <field name="file" filename="file_name" string="Document"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="journal_id" required="state == 'upload' and not move_id" readonly="move_id"/>
                            <field name="move_type"/>
                        </group>
                    </group>
                </div>

                <!-- STEP 2: review mask -->
                <div invisible="state != 'review'">
                    <div class="alert alert-warning mb-2" role="alert" invisible="not low_confidence">
                        <strong>Check carefully:</strong> Claude has low confidence on <field name="low_confidence" class="d-inline"/>.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not has_existing_lines">
                        The current lines of <field name="move_id" class="d-inline" readonly="1"/> will be replaced by the lines below.
                    </div>
                    <div class="row">
                        <div class="col-lg-5 o_claude_ocr_preview">
                            <field name="file_pdf" widget="pdf_viewer" filename="file_name" readonly="1" nolabel="1"
                                   invisible="not is_pdf"/>
                            <field name="file_image" widget="image" readonly="1" nolabel="1"
                                   invisible="is_pdf"/>
                        </div>
                        <div class="col-lg-7">
                            <group>
                                <group string="Vendor">
                                    <field name="partner_id" options="{'no_create': True}"
                                           placeholder="Not found: will be created from the data read"/>
                                    <field name="create_partner" invisible="partner_id"/>
                                    <field name="supplier_name"/>
                                    <field name="supplier_vat"/>
                                    <field name="supplier_street"/>
                                    <field name="supplier_zip" invisible="partner_id"/>
                                    <field name="supplier_city" invisible="partner_id"/>
                                    <field name="supplier_country_id" invisible="partner_id"/>
                                    <field name="supplier_email"/>
                                    <field name="supplier_phone"/>
                                    <field name="iban"/>
                                </group>
                                <group string="Bill">
                                    <field name="move_type"/>
                                    <field name="journal_id" readonly="move_id" required="not move_id"/>
                                    <field name="ref"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="currency_id" options="{'no_create': True}"/>
                                    <field name="payment_reference"/>
                                    <field name="invoice_origin"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Invoice Lines" name="lines">
                                    <field name="line_ids">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="company_id" column_invisible="1"/>
                                            <field name="name"/>
                                            <field name="product_code" optional="hide"/>
                                            <field name="product_id" optional="show" options="{'no_create': True}"/>
                                            <field name="quantity"/>
                                            <field name="price_unit"/>
                                            <field name="discount" optional="show"/>
                                            <field name="tax_rate_read" optional="show" readonly="1"/>
                                            <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                            <field name="price_subtotal"/>
                                        </list>
                                    </field>
                                    <group>
                                        <group/>
                                        <group string="Totals">
                                            <field name="amount_untaxed_lines" decoration-danger="totals_mismatch"/>
                                            <field name="amount_untaxed_read" decoration-danger="totals_mismatch"/>
                                            <field name="amount_tax_read"/>
                                            <field name="amount_total_read"/>
                                        </group>
                                    </group>
                                </page>
                                <page string="Notes" name="notes">
                                    <field name="narration" placeholder="Terms and conditions, notes..."/>
                                </page>
                            </notebook>
                        </div>
                    </div>

                    <!-- Data Claude could not place: the user decides the destination -->
                    <separator string="Data read but not placed"/>
                    <div class="alert alert-info mb-2" role="alert" invisible="not unmapped_pending_count">
                        Claude read these data but could not decide which field they belong to.
                        Choose where each one goes (or <strong>Discard</strong> it): the value is moved
                        immediately to the chosen field of the bill above.
                    </div>
                    <field name="unmapped_ids" nolabel="1">
                        <list editable="bottom" create="0" decoration-warning="not target" decoration-muted="target == 'discard'">
                            <field name="label" readonly="1"/>
                            <field name="value"/>
                            <field name="target"/>
                            <field name="applied_target" column_invisible="1"/>
                        </list>
                    </field>
                </div>

                <footer>
                    <button name="action_read" string="Read with Claude" type="object" class="btn-primary"
                            invisible="state != 'upload'" data-hotkey="q"/>
                    <button name="action_confirm" string="Confirm and fill bill" type="object" class="btn-primary"
                            invisible="state != 'review'" data-hotkey="q"/>
                    <button name="action_read" string="Read again" type="object" class="btn-secondary"
                            invisible="state != 'review'"
                            confirm="Your changes in this wizard will be lost. Read the document again?"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_claude_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Digitize with Claude</field>
        <field name="res_model">claude.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <menuitem id="menu_claude_invoice_wizard"
              name="Digitize with Claude"
              parent="account.menu_finance_payables"
              action="action_claude_invoice_wizard"
              groups="account.group_account_invoice"
              sequence="3"/>

</odoo>
