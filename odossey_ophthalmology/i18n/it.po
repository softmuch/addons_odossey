#. module: odossey_ophthalmology
#: model:mail.template,body_html:odossey_ophthalmology.mail_template_control_recall
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Ana</t>,</p>\n"
"    <p>According to your last visit, your next eye control is due on\n"
"        <b t-out=\"format_date(object.oph_next_control_date)\">01/12/2026</b>.</p>\n"
"    <p>Regular controls are essential to protect your vision. Reply to this email or call us to book your appointment.</p>\n"
"    <p>Best regards,<br/><t t-out=\"user.company_id.name or ''\">The clinic</t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Buongiorno <t t-out=\"object.name or ''\">Ana</t>,</p>\n"
"    <p>In base alla sua ultima visita, il prossimo controllo oculistico è previsto per il\n"
"        <b t-out=\"format_date(object.oph_next_control_date)\">01/12/2026</b>.</p>\n"
"    <p>I controlli regolari sono fondamentali per proteggere la vista. Risponda a questa e-mail o ci chiami per prenotare l'appuntamento.</p>\n"
"    <p>Cordiali saluti,<br/><t t-out=\"user.company_id.name or ''\">La clinica</t></p>\n"
"</div>\n"
"            "

#. module: odossey_ophthalmology
#: model:mail.template,body_html:odossey_ophthalmology.mail_template_appointment_reminder
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Hello <t t-out=\"object.oph_patient_id.name or ''\">Ana</t>,</p>\n"
"    <p>We remind you of your appointment at <t t-out=\"user.company_id.name or ''\">the clinic</t>:</p>\n"
"    <ul>\n"
"        <li>Date and time: <t t-out=\"format_datetime(object.start, tz=object.oph_patient_id.tz or user.tz, dt_format='short')\">01/12/2026 10:00</t></li>\n"
"        <li t-if=\"object.user_id\">Professional: <t t-out=\"object.user_id.name or ''\">Dr. Pérez</t></li>\n"
"        <li t-if=\"object.oph_appointment_type_id\">Type: <t t-out=\"object.oph_appointment_type_id.name or ''\">Control</t></li>\n"
"    </ul>\n"
"    <p>Please bring your current glasses, the list of the medication you use, your ID and your health insurance card.\n"
"        If your pupils are dilated your vision will be blurred for some hours: come with a companion and do not drive.</p>\n"
"    <p>If you cannot come, please let us know by replying to this email.</p>\n"
"    <p>Best regards,<br/><t t-out=\"user.company_id.name or ''\">The clinic</t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Buongiorno <t t-out=\"object.oph_patient_id.name or ''\">Ana</t>,</p>\n"
"    <p>Le ricordiamo il suo appuntamento presso <t t-out=\"user.company_id.name or ''\">la clinica</t>:</p>\n"
"    <ul>\n"
"        <li>Data e ora: <t t-out=\"format_datetime(object.start, tz=object.oph_patient_id.tz or user.tz, dt_format='short')\">01/12/2026 10:00</t></li>\n"
"        <li t-if=\"object.user_id\">Professionista: <t t-out=\"object.user_id.name or ''\">Dr. Pérez</t></li>\n"
"        <li t-if=\"object.oph_appointment_type_id\">Tipo: <t t-out=\"object.oph_appointment_type_id.name or ''\">Controllo</t></li>\n"
"    </ul>\n"
"    <p>La preghiamo di portare gli occhiali attuali, l'elenco dei farmaci che utilizza, un documento d'identità e la tessera dell'assicurazione sanitaria.\n"
"        Se le pupille vengono dilatate, la vista resterà offuscata per alcune ore: venga accompagnato e non guidi.</p>\n"
"    <p>Se non può venire, ce lo comunichi rispondendo a questa e-mail.</p>\n"
"    <p>Cordiali saluti,<br/><t t-out=\"user.company_id.name or ''\">La clinica</t></p>\n"
"</div>\n"
"            "

