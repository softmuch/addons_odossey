<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odossey_partial_payments_pos.PaymentScreenValidate"
       t-inherit="point_of_sale.PaymentScreenValidate"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('validation-button')]" position="after">
            <!-- Offered as soon as there's SOMETHING to register against the
                 order: real cash/card tendered, or just banked credit
                 with the checkbox on (a cashier can register a credit-only
                 partial payment with zero payment lines: see
                 `order_payment_validation.js`'s own credit-aware
                 `hasEffectivePayment`), as long as it wouldn't already
                 close the order outright (`isCoveredByCustomerCredit`):
                 there's nothing "partial" left to register then, Validate
                 alone closes it (see `canBeValidated`/`isOrderValid`). -->
            <button class="btn btn-secondary btn-lg py-3 lh-lg o_partial_payment_button"
                t-if="(currentOrder.amountPaid > 0 or currentOrder.appliedCustomerCredit() > 0) and !currentOrder.isPaid() and !currentOrder.isCoveredByCustomerCredit()"
                t-on-click="() => this.validatePartialOrder()"
                t-attf-class="{{ ui.isSmall ? 'btn-switchpane flex-fill' : 'button w-50' }}"
            >
                <span>Partial Payment</span>
            </button>
        </xpath>
    </t>

    <t t-name="odossey_partial_payments_pos.PaymentScreenDue"
       t-inherit="point_of_sale.PaymentScreenDue"
       t-inherit-mode="extension">
        <!-- Net of any customer credit about to be applied (see
             `displayedTotalDue`); `currentOrder.totalDue` itself is left
             untouched, it's still the real order total used elsewhere
             (invoicing, receipts, accounting). -->
        <xpath expr="//PriceFormatter" position="attributes">
            <attribute name="price">this.env.utils.formatCurrency(displayedTotalDue)</attribute>
        </xpath>
    </t>

    <t t-name="odossey_partial_payments_pos.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <!-- Own full-width row, right under the Customer/Recibo-Factura row
             (not squeezed between them), for more room to read/tap. -->
        <xpath expr="//button[hasclass('js_invoice')]/parent::div" position="after">
            <div t-if="customerCreditBalance > 0 and !currentOrder.isPaid()"
                class="o_customer_credit_toggle button btn btn-secondary btn-lg d-flex align-items-center justify-content-center gap-2 w-100 lh-lg py-3">
                <input type="checkbox" id="o_use_customer_credit"
                    t-att-checked="useCustomerCredit"
                    t-on-change="toggleCustomerCredit"/>
                <label for="o_use_customer_credit" class="mb-0 d-flex align-items-center gap-1">
                    <i class="fa fa-credit-card-alt me-1"/>
                    <span>Use Credit</span>
                    <t t-esc="' (' + this.env.utils.formatCurrency(customerCreditBalance) + ')'"/>
                </label>
            </div>
        </xpath>
    </t>
</templates>
