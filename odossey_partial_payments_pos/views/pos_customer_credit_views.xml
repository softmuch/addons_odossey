<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_customer_credit_view_tree" model="ir.ui.view">
        <field name="name">pos.customer.credit.list</field>
        <field name="model">pos.customer.credit</field>
        <field name="arch" type="xml">
            <list string="Customer Credits" create="0">
                <field name="date" />
                <field name="partner_id" />
                <field name="amount" decoration-success="amount &gt; 0" decoration-danger="amount &lt; 0" />
                <field name="origin_order_id" />
                <field name="used_order_id" />
            </list>
        </field>
    </record>

    <record id="pos_customer_credit_view_search" model="ir.ui.view">
        <field name="name">pos.customer.credit.search</field>
        <field name="model">pos.customer.credit</field>
        <field name="arch" type="xml">
            <search string="Customer Credits">
                <field name="partner_id" />
                <group>
                    <filter name="group_by_partner" string="Customer" domain="[]" context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="pos_customer_credit_action" model="ir.actions.act_window">
        <field name="name">Customer Credits</field>
        <field name="res_model">pos.customer.credit</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_partner': 1}</field>
    </record>

    <menuitem
        id="menu_pos_customer_credit"
        parent="point_of_sale.menu_point_of_sale"
        action="pos_customer_credit_action"
        sequence="4"
        groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"
    />
</odoo>
