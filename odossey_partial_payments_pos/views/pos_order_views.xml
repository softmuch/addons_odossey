<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_pos_form_inherit_partial_payments" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.partial.payments</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(point_of_sale.action_pos_payment)d']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'partially_paid')</attribute>
            </xpath>
            <xpath expr="//button[@name='%(point_of_sale.action_pos_payment)d']" position="before">
                <button name="action_pos_order_set_draft" string="Volver a Borrador" type="object"
                        invisible="state != 'partially_paid'"
                        confirm="La orden volverá a borrador para poder editarla. ¿Continuar?"/>
            </xpath>
            <xpath expr="(//field[@name='state'])[1]" position="attributes">
                <attribute name="statusbar_visible">draft,partially_paid,paid,done</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_inherit_partial_payments" model="ir.ui.view">
        <field name="name">pos.order.list.inherit.partial.payments</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="decoration-warning">state == 'partially_paid'</attribute>
                <attribute name="decoration-success">state not in ('draft', 'cancel', 'partially_paid')</attribute>
            </field>
        </field>
    </record>

    <record id="view_pos_order_kanban_inherit_partial_payments" model="ir.ui.view">
        <field name="name">pos.order.kanban.inherit.partial.payments</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_kanban"/>
        <field name="arch" type="xml">
            <field name="state" position="attributes">
                <attribute name="options">{'classes': {'draft': 'default', 'partially_paid': 'warning', 'done': 'success', 'cancel': 'danger'}}</attribute>
            </field>
        </field>
    </record>

</odoo>
