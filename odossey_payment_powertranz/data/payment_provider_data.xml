<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Created disabled: enabling it activates the card payment methods. -->
    <record id="payment_provider_powertranz" model="payment.provider">
        <field name="name">PowerTranz</field>
        <field name="code">powertranz</field>
        <field name="state">disabled</field>
        <field name="is_published" eval="False"/>
        <field name="image_128" type="base64" file="odossey_payment_powertranz/static/description/icon.png"/>
        <field name="module_id" ref="base.module_odossey_payment_powertranz"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="allow_tokenization" eval="False"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_card')])]"/>
    </record>

</odoo>
