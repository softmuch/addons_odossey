#. module: odossey_payment_powertranz
#: model:ir.model.fields,help:odossey_payment_powertranz.field_payment_provider__powertranz_api_url
msgid ""
"Leave empty to use the default production API "
"(https://gateway.ptranz.com/api/). Only change it if the bank gives you "
"another host."
msgstr ""
"Déjelo vacío para usar la API de producción por defecto "
"(https://gateway.ptranz.com/api/). Cámbielo solo si el banco le da otro "
"host."

