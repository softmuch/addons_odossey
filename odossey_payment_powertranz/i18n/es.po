#. module: odossey_payment_powertranz
#: model:ir.model.fields,field_description:odossey_payment_powertranz.field_payment_provider__powertranz_use_3ds
#: model_terms:ir.ui.view,arch_db:odossey_payment_powertranz.payment_provider_form
msgid "3-D Secure"
msgstr "3-D Secure"

#. module: odossey_payment_powertranz
#: model:ir.model.fields,field_description:odossey_payment_powertranz.field_payment_provider__powertranz_allow_non_3ds_cards
msgid "Accept cards without 3-D Secure"
msgstr "Aceptar tarjetas sin 3-D Secure"

#. module: odossey_payment_powertranz
#: model:ir.model.fields,field_description:odossey_payment_powertranz.field_payment_provider__powertranz_allow_3ds_unavailable
msgid "Accept when 3-D Secure is unavailable"
msgstr "Aceptar cuando 3-D Secure no está disponible"

#. module: odossey_payment_powertranz
#: model:ir.model.fields,help:odossey_payment_powertranz.field_payment_provider__powertranz_use_3ds
msgid ""
"Authenticate the cardholder with 3-D Secure on the hosted page "
"(recommended)."
msgstr ""
"Autenticar al titular de la tarjeta con 3-D Secure en la página de pago "
"(recomendado)."

#. module: odossey_payment_powertranz
#. odoo-python
#: code:addons/odossey_payment_powertranz/models/payment_transaction.py:0
msgid "Authorization code: %s"
msgstr "Código de autorización: %s"

#. module: odossey_payment_powertranz
#: model:ir.model.fields,field_description:odossey_payment_powertranz.field_payment_provider__code
msgid "Code"
msgstr "Código"

#. module: odossey_payment_powertranz
#: model:ir.model.fields,help:odossey_payment_powertranz.field_payment_provider__powertranz_allow_3ds_unavailable
msgid ""
"Complete the payment when the 3-D Secure authentication could not be "
"performed (status U, technical problem). There is no liability shift for "
"these payments."
msgstr ""
"Completar el pago cuando no se pudo realizar la autenticación 3-D Secure "
"(estado U, problema técnico). Estos pagos no tienen traslado de "
"responsabilidad (liability shift)."

#. module: odossey_payment_powertranz
#: model:ir.model.fields,help:odossey_payment_powertranz.field_payment_provider__powertranz_allow_non_3ds_cards
msgid ""
"Complete the payment when the card is not enrolled in 3-D Secure. There is "
"no liability shift for these payments."
msgstr ""
"Completar el pago cuando la tarjeta no está inscrita en 3-D Secure. Estos "
"pagos no tienen traslado de responsabilidad (liability shift)."

#. module: odossey_payment_powertranz
#. odoo-python
#: code:addons/odossey_payment_powertranz/models/payment_provider.py:0
msgid "Could not establish the connection to the API."
