<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- GET to the local route serving the hosted page HTML. The values are sent as inputs
         because a GET submit drops the query string of the action. -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <input type="hidden" name="reference" t-att-value="reference"/>
            <input type="hidden" name="access_token" t-att-value="access_token"/>
        </form>
    </template>

</odoo>
