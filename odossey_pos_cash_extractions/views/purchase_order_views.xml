<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_pos_cash_extraction" model="ir.ui.view">
        <field name="name">purchase.order.form.pos.cash.extraction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_calculation_rounding_method']" position="before">
                <field name="has_open_pos_session" invisible="1"/>
                <field name="pos_extract_cash" widget="boolean_toggle" options="{'autosave': false}"
                    invisible="state in ('draft', 'sent', 'to approve') and not has_open_pos_session"
                    readonly="state in ('purchase', 'done', 'cancel')"/>
                <field name="pos_session_id"
                    invisible="not pos_extract_cash"
                    required="pos_extract_cash"
                    readonly="state in ('purchase', 'done', 'cancel')"
                    options="{'no_create': True}"/>
                <field name="pos_cash_move_id" invisible="not pos_cash_move_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
