<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odossey_pos_delivery.DeliveryScreen">
        <div class="delivery-screen screen d-flex flex-column h-100">

            <!-- Header -->
            <div class="delivery-header d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom shadow-sm">
                <button class="btn btn-light btn-lg" t-on-click="back">
                    <i class="oi oi-chevron-left me-2"/><t t-esc="label('back')"/>
                </button>
                <h1 class="mb-0 fw-bold">
                    <i class="fa fa-motorcycle me-2 text-primary"/>Delivery
                </h1>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-lg" t-on-click="loadOrders">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button class="btn btn-warning btn-lg fw-bold" t-on-click="openNewDeliveryOrder">
                        <i class="fa fa-plus me-2"/><t t-esc="label('newOrder')"/>
                    </button>
                </div>
            </div>

            <!-- Loading / Error -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center flex-grow-1">
                    <div class="spinner-border text-primary" role="status"/>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-danger m-3" t-esc="state.error"/>
            </t>

            <!-- Content -->
            <t t-else="">
                <div class="delivery-content flex-grow-1 overflow-y-auto p-3">

                    <!-- PREPARING -->
                    <div class="delivery-section mb-4">
                        <div class="delivery-section-header preparing d-flex align-items-center px-3 py-2 rounded-top">
                            <i class="fa fa-fire me-2"/>
                            <strong t-esc="label('preparing')"/>
                            <span class="badge bg-white text-dark ms-2" t-esc="preparingOrders.length"/>
                            <div class="ms-auto">
                                <button t-if="preparingOrders.length > 0"
                                        class="btn btn-sm btn-light"
                                        t-on-click="() => this.advanceAll('preparing')">
                                    <t t-esc="label('advanceAll')"/> →
                                </button>
                            </div>
                        </div>
                        <t t-call="odossey_pos_delivery.DeliveryTable">
                            <t t-set="orders" t-value="preparingOrders"/>
                            <t t-set="sectionState" t-value="'preparing'"/>
                        </t>
                    </div>

                    <!-- READY -->
                    <div class="delivery-section mb-4">
                        <div class="delivery-section-header ready d-flex align-items-center px-3 py-2 rounded-top">
                            <i class="fa fa-check me-2"/>
                            <strong t-esc="label('ready')"/>
                            <span class="badge bg-white text-dark ms-2" t-esc="readyOrders.length"/>
                            <div class="ms-auto">
                                <button t-if="readyOrders.length > 0"
                                        class="btn btn-sm btn-light"
                                        t-on-click="() => this.advanceAll('ready')">
                                    <t t-esc="label('advanceAll')"/> →
                                </button>
                            </div>
                        </div>
                        <t t-call="odossey_pos_delivery.DeliveryTable">
                            <t t-set="orders" t-value="readyOrders"/>
                            <t t-set="sectionState" t-value="'ready'"/>
                        </t>
                    </div>

                    <!-- SENT -->
                    <div class="delivery-section mb-4">
                        <div class="delivery-section-header sent d-flex align-items-center px-3 py-2 rounded-top">
                            <i class="fa fa-bicycle me-2"/>
                            <strong t-esc="label('sent')"/>
                            <span class="badge bg-white text-dark ms-2" t-esc="sentOrders.length"/>
                            <div class="ms-auto">
                                <button t-if="sentOrders.length > 0"
                                        class="btn btn-sm btn-light"
                                        t-on-click="() => this.advanceAll('sent')">
                                    <t t-esc="label('advanceAll')"/> →
                                </button>
                            </div>
                        </div>
                        <t t-call="odossey_pos_delivery.DeliveryTable">
                            <t t-set="orders" t-value="sentOrders"/>
                            <t t-set="sectionState" t-value="'sent'"/>
                        </t>
                    </div>

                    <!-- DELIVERED -->
                    <div class="delivery-section mb-4">
                        <div class="delivery-section-header delivered d-flex align-items-center px-3 py-2 rounded-top">
                            <i class="fa fa-flag-checkered me-2"/>
                            <strong t-esc="label('delivered')"/>
                            <span class="badge bg-white text-dark ms-2" t-esc="deliveredOrders.length"/>
                            <div class="ms-auto">
                                <button t-if="deliveredPaidVisible.length > 0"
                                        class="btn btn-sm btn-light"
                                        t-on-click="hideAllDelivered">
                                    <i class="fa fa-eye-slash me-1"/><t t-esc="label('hideAllPaid')"/>
                                </button>
                            </div>
                        </div>
                        <t t-call="odossey_pos_delivery.DeliveryTable">
                            <t t-set="orders" t-value="deliveredOrders"/>
                            <t t-set="sectionState" t-value="'delivered'"/>
                            <t t-set="allowHideOrder" t-value="true"/>
                        </t>
                    </div>

                </div>
            </t>
        </div>
    </t>

    <!-- Reusable table sub-template -->
    <t t-name="odossey_pos_delivery.DeliveryTable">
        <div class="table-responsive bg-white rounded-bottom border border-top-0">
            <table class="table table-sm table-hover mb-0 delivery-table">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th t-esc="label('time')"/>
                        <th t-esc="label('customer')"/>
                        <th t-esc="label('address')"/>
                        <th t-esc="label('phone')"/>
                        <th t-esc="label('payment')"/>
                        <th class="text-end" t-esc="label('total')"/>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="orders.length === 0">
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3" t-esc="label('noOrders')"/>
                        </tr>
                    </t>
                    <t t-foreach="orders" t-as="order" t-key="order.id">
                        <tr t-att-class="this.openable(order) ? 'delivery-row-openable cursor-pointer' : 'opacity-50'"
                            t-on-click="() => this.onRowClick(order)">
                            <td class="fw-bold text-muted">
                                #<t t-esc="order.id"/>
                                <t t-if="this.openable(order)">
                                    <i class="fa fa-pencil ms-1 text-primary opacity-50"/>
                                </t>
                            </td>
                            <td t-esc="formatTime(order.start_time)"/>
                            <td>
                                <div class="fw-semibold" t-esc="order.partner_name or '-'"/>
                                <t t-if="order.note">
                                    <small class="text-muted d-block" t-esc="order.note"/>
                                </t>
                            </td>
                            <td t-esc="order.delivery_address or '-'"/>
                            <td t-esc="order.partner_phone or '-'"/>
                            <td>
                                <span t-if="order.payment_state === 'paid'"
                                      class="badge bg-success"
                                      t-esc="label('paid')"/>
                                <span t-else=""
                                      class="badge bg-danger"
                                      t-esc="label('unpaid')"/>
                            </td>
                            <td class="text-end fw-semibold" t-esc="formatAmount(order.amount_total)"/>
                            <td class="text-end text-nowrap" t-on-click.stop="">
                                <!-- Retreat button -->
                                <t t-if="this.canRetreat(order)">
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            t-on-click="() => this.retreatState(order)">
                                        ← <t t-esc="this.getPrevStateLabel(order.delivery_state)"/>
                                    </button>
                                </t>
                                <!-- Advance button -->
                                <t t-if="this.canAdvance(order)">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            t-on-click="() => this.advanceState(order)">
                                        → <t t-esc="this.getNextStateLabel(order.delivery_state)"/>
                                    </button>
                                </t>
                                <!-- Hide button: only in delivered section, only for paid orders -->
                                <t t-if="allowHideOrder and order.payment_state === 'paid'">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            t-on-click="() => this.hideDeliveredOrder(order)">
                                        <i class="fa fa-eye-slash"/>
                                    </button>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
