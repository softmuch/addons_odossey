<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odossey_pos_delivery.Navbar"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <!-- Orange topheader when active order is a delivery order -->
        <xpath expr="//div[hasclass('pos-topheader')]" position="attributes">
            <attribute name="t-att-class">{'bg-delivery-order border-0': isDeliveryOrder || isDeliveryScreen}</attribute>
        </xpath>
        <!-- Override pos_restaurant "Plan" text with "Tables".
             - On FloorScreen: violet (btn-primary) + white text, like at start.
             - Table open (selectedTable): bg #495057 + white text.
             - Otherwise (Delivery/Mostrador express selected): transparent, inherits navbar
               color/hover just like the Delivery/Mostrador nav buttons (see .back-button rule
               in DeliveryScreen.scss). -->
        <xpath expr="//button[hasclass('back-button')]" position="attributes">
            <attribute name="t-att-class">screen === 'FloorScreen' ? 'btn-primary text-white' : (pos.selectedTable ? 'text-white' : '')</attribute>
            <attribute name="t-att-style">pos.selectedTable ? 'background-color: #495057;' : ''</attribute>
        </xpath>
        <xpath expr="//button[hasclass('back-button')]/span" position="replace">
            <i t-if="!ui.isSmall" class="fa fa-th-large me-1"/>
            <span t-if="!ui.isSmall">Tables</span>
        </xpath>
        <!-- Place delivery button after "Plan", before "Mesa" -->
        <xpath expr="//button[hasclass('back-button')]" position="after">
            <button class="delivery-nav-button btn btn-lg lh-lg"
                    t-att-class="{'btn-delivery-active': isDeliveryScreen}"
                    t-on-click="openDeliveryScreen">
                <i class="fa fa-motorcycle me-1"/>
                <span>Delivery</span>
            </button>
        </xpath>
        <!-- Prevent "Mesa" from appearing selected when on DeliveryScreen -->
        <xpath expr="//button[hasclass('table-free-order-label')]" position="attributes">
            <attribute name="t-att-class">{'btn-primary': !['ActionScreen', 'FloorScreen', 'DeliveryScreen'].includes(screen)}</attribute>
        </xpath>
    </t>
</templates>
