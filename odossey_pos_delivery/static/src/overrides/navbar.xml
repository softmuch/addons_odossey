<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odossey_pos_delivery.Navbar"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('table-free-order-label')]" position="after">
            <button class="delivery-nav-button btn btn-lg lh-lg"
                    t-att-class="{'btn-primary': isDeliveryScreen}"
                    t-on-click="openDeliveryScreen">
                <i class="fa fa-motorcycle me-1"/>
                <span>Delivery</span>
            </button>
        </xpath>
    </t>
</templates>
