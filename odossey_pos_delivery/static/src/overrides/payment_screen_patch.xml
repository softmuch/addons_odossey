<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odossey_pos_delivery.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="after">
            <button class="button js_delivery btn btn-light btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                    t-att-class="{ 'highlight active text-action': currentOrder.is_delivery }"
                    t-on-click="toggleIsDelivery">
                <span><i class="fa fa-motorcycle me-2"/>Delivery</span>
                <i class="fa me-2"
                   t-attf-class="{{ currentOrder.is_delivery ? 'fa-check-square text-action' : 'fa-square-o' }}"/>
            </button>
        </xpath>
    </t>
</templates>
