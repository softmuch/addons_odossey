<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_order_list.NfOrderListButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/NoteButton" position="after">
            <button class="control-button btn btn-secondary rounded-0 fw-bolder" t-on-click="() => this.GlobalDiscount()">
                <span class='fa fa-percent'></span>
                Global Discount
            </button>
            <button class="control-button btn btn-secondary rounded-0 fw-bolder" t-on-click="() => this.removeDiscount()">
                <span class='fa fa-times'></span>
                Remove all Discount
            </button>
        </xpath>
    </t>

</templates>
