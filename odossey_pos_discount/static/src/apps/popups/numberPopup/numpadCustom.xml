<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-extend='NumberPopup' t-inherit='point_of_sale.NumberPopup' t-inherit-mode='extension' owl='1'>
        <xpath expr="//div[hasclass('justify-content-center')]" position="attributes">
            <attribute name="t-attf-class"> {{ props.is_custom_discount ? 'nf_discount_popup' : '' }}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('popup-input')]" position="before">
            <div class="get-discount-type d-flex gap-2 mb-2" t-if="props.is_custom_discount">
                <label class="nf-discount-option btn btn-lg flex-grow-1 d-flex align-items-center justify-content-center"
                       t-att-class="{'btn-primary': state.discount_type === 'price', 'btn-secondary': state.discount_type !== 'price'}">
                    <input type="radio" name="nf-discount" value="price" t-on-change="setType" class="d-none"/>
                    Price
                </label>
                <label class="nf-discount-option btn btn-lg flex-grow-1 d-flex align-items-center justify-content-center"
                       t-att-class="{'btn-primary': state.discount_type === 'percentage', 'btn-secondary': state.discount_type !== 'percentage'}">
                    <input type="radio" name="nf-discount" value="percentage" t-on-change="setType" class="d-none"/>
                    Percentage
                </label>
            </div>
        </xpath>
    </t>
</templates>