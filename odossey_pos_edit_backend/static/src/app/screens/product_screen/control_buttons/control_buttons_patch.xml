<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odossey_pos_edit_backend.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//NoteButton" position="before">
            <button t-if="this.pos.cashier._role != 'minimal'" t-att-class="buttonClass"
                    t-on-click="() => this.clickPayFreely()">
                <i class="fa fa-money me-1" role="img" aria-label="Pagar Libremente" title="Pagar Libremente"/>
                Pagar Libremente
            </button>
        </xpath>
    </t>
</templates>
