msgstr "Listino per Modalità di Cassa"

#. module: odossey_pos_express_checkout_pricelist
#: model:ir.model.fields,help:odossey_pos_express_checkout_pricelist.field_pos_config__use_checkout_mode_pricelist
#: model:ir.model.fields,help:odossey_pos_express_checkout_pricelist.field_res_config_settings__use_checkout_mode_pricelist
