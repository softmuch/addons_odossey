<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="odossey_pos_express_checkout_pricelist_config_view" model="ir.ui.view">
        <field name="name">odossey.pos.express.checkout.pricelist.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_pricing_section" position="inside">
                <setting id="use_checkout_mode_pricelist_setting"
                         help="Apply a different default pricelist depending on whether the order was started in Express Checkout mode or Floor (table) mode.">
                    <field name="use_checkout_mode_pricelist"/>
                    <div class="content-group" invisible="not use_checkout_mode_pricelist">
                        <div class="row mt16">
                            <label for="express_checkout_pricelist_id" class="col-lg-4 o_light_label" string="Express Checkout Pricelist"/>
                            <field name="express_checkout_pricelist_id" class="oe_inline"/>
                        </div>
                        <div class="row mt8">
                            <label for="floor_checkout_pricelist_id" class="col-lg-4 o_light_label" string="Floor Mode Pricelist"/>
                            <field name="floor_checkout_pricelist_id" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
