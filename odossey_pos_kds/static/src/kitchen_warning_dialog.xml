<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odossey_pos_kds.KitchenWarningDialog">
        <Dialog size="'md'" title="props.title">
            <div class="d-flex align-items-start gap-3 py-2">
                <i class="fa fa-exclamation-triangle fa-2x text-warning mt-1 flex-shrink-0"/>
                <p class="mb-0 fs-6" t-esc="props.body"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="cancel">
                    <t t-esc="props.cancelLabel"/>
                </button>
                <button class="btn btn-primary btn-lg" t-on-click="sendToKitchen">
                    <t t-esc="props.orderLabel"/>
                </button>
                <button class="btn btn-primary btn-lg" t-on-click="proceed">
                    <t t-esc="props.proceedLabel"/>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
