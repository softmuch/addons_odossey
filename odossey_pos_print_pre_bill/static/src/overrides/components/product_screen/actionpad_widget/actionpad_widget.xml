<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odossey_pos_print_pre_bill.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <!-- Remove categories for saving space -->
        <xpath expr="//button[hasclass('submit-order')]/div" position="attributes">
            <attribute name="t-if">!pos.config.is_order_printer</attribute>
        </xpath>
        <!-- Show button name also in smartphone -->
        <xpath expr="//button[hasclass('submit-order')]/t" position="attributes">
            <attribute name="t-if">!(ui.isSmall or displayCategoryCount.length > 2) or (!displayCategoryCount.length and ui.isSmall) or pos.config.is_order_printer</attribute>
        </xpath>
        <!-- When not restaurant: add Order button to the left of Pay button inside validation div -->
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay') and hasclass('pay-order-button')]" position="before">
            <button t-if="!pos.config.module_pos_restaurant"
                class="submit-order h-100 button btn btn-lg d-flex align-items-center w-50 flex-fill position-relative px-3"
                t-att-class="swapButtonClasses"
                t-on-click="submitOrder"
            >
                <t t-if="!(ui.isSmall or displayCategoryCount.length > 2) or (!displayCategoryCount.length and ui.isSmall)">Order</t>
                <div t-attf-class="{{ !(displayCategoryCount.length > 2) ? 'd-flex flex-column align-items-end gap-1' : 'row row-cols-2 g-1 gx-2' }} {{ isCategoryCountOverflow ? 'mt-n3' : ''}}">
                    <t t-if="displayCategoryCount.length">
                        <t t-foreach="displayCategoryCount" t-as="categoryCountLine"  t-key="categoryCountLine_index">
                            <div class="d-flex align-items-center justify-content-between small" t-att-class="{ 'gap-2' : !(displayCategoryCount.length > 2) }">
                                <label class="text-truncate"><t t-esc="categoryCountLine.name"/></label>
                                <label class="rounded px-2 py-0" style="background-color:rgba(0, 0, 0, 0.3);"><t t-esc="this.env.utils.formatProductQty(categoryCountLine.count, false)"/></label>
                            </div>
                        </t>
                    </t>
                    <t t-if="isCategoryCountOverflow">
                        <div class="position-absolute bottom-0 start-50 translate-middle-x">...</div>
                    </t>
                </div>
            </button>
        </xpath>
        <!-- Add "Set Done" and "Print" buttons below Order/Payment buttons -->
        <xpath expr="//div[hasclass('validation')]" position="after">
            <div class="d-flex gap-2">
                <button
                    class="set-done button btn btn-success btn-lg d-flex align-items-center justify-content-center flex-fill"
                    t-att-class="swapButtonClasses"
                    t-on-click="orderSetDone"
                >
                    Set Done
                </button>
                <button t-if="pos.config.is_order_printer"
                    class="order-and-print button btn btn-danger btn-lg d-flex align-items-center justify-content-center flex-fill"
                    t-att-class="swapButtonClasses"
                    t-on-click="orderAndPrint"
                >
                    Print
                </button>
            </div>
        </xpath>
    </t>
</templates>