<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odossey_pos_print_pre_bill.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <!-- Remove categories for saving space -->
        <xpath expr="//button[hasclass('submit-order')]/div" position="attributes">
            <attribute name="t-if">!pos.config.is_order_printer</attribute>
        </xpath>
        <!-- Show button name also in smartphone -->
        <xpath expr="//button[hasclass('submit-order')]/t" position="attributes">
            <attribute name="t-if">!(ui.isSmall or displayCategoryCount.length > 2) or (!displayCategoryCount.length and ui.isSmall) or pos.config.is_order_printer</attribute>
        </xpath>
        <!-- Add "Set Done" and "Print" buttons below Order/Payment buttons -->
        <xpath expr="//div[hasclass('validation')]" position="after">
            <div class="d-flex gap-2">
                <button t-if="!pos.config.module_pos_restaurant"
                    class="submit-order button btn btn-primary btn-lg d-flex align-items-center justify-content-center flex-fill"
                    t-on-click="submitOrder"
                >
                    Order
                </button>
                <button
                    class="set-done button btn btn-success btn-lg d-flex align-items-center justify-content-center flex-fill"
                    t-att-class="swapButtonClasses"
                    t-on-click="orderSetDone"
                >
                    Set Done
                </button>
                <button t-if="pos.config.is_order_printer"
                    class="order-and-print button btn btn-danger btn-lg d-flex align-items-center justify-content-center flex-fill"
                    t-att-class="swapButtonClasses"
                    t-on-click="orderAndPrint"
                >
                    Print
                </button>
            </div>
        </xpath>
    </t>
</templates>
