<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_printer_qztray_form" model="ir.ui.view">
        <field name="name">pos.printer.qztray.form</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">

            <field name="printer_type" position="after">

                <!-- QZ Tray WebSocket connection -->
                <field name="qztray_host"
                       string="QZ Tray Host"
                       invisible="printer_type != 'qztray'"
                       placeholder="localhost"/>
                <field name="qztray_port"
                       string="QZ Tray Port"
                       invisible="printer_type != 'qztray'"/>

                <!-- Connection mode -->
                <field name="qztray_mode"
                       widget="radio"
                       invisible="printer_type != 'qztray'"/>

                <!-- OS printer mode -->
                <field name="qztray_printer_name"
                       string="OS Printer Name"
                       invisible="printer_type != 'qztray' or qztray_mode != 'os'"
                       placeholder="EPSON TM-T20III"/>

                <!-- Socket mode -->
                <field name="qztray_socket_ip"
                       string="Printer IP"
                       invisible="printer_type != 'qztray' or qztray_mode != 'socket'"
                       required="printer_type == 'qztray' and qztray_mode == 'socket'"
                       placeholder="192.168.0.52"/>
                <field name="qztray_socket_port"
                       string="Printer Port"
                       invisible="printer_type != 'qztray' or qztray_mode != 'socket'"/>

                <!-- Shared -->
                <field name="qztray_paper_width_mm"
                       string="Paper Width (mm)"
                       invisible="printer_type != 'qztray'"/>

                <!-- Signing (optional) -->
                <field name="qztray_certificate"
                       string="QZ Tray Certificate (optional)"
                       invisible="printer_type != 'qztray'"/>
                <field name="qztray_private_key"
                       string="Private Key (optional)"
                       password="True"
                       invisible="printer_type != 'qztray'"/>

                <button name="action_test_qztray"
                        string="QZ Tray Info"
                        type="object"
                        class="btn-secondary"
                        invisible="printer_type != 'qztray'"/>

            </field>

        </field>
    </record>

</odoo>
