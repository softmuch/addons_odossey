<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_printer_qztray_form" model="ir.ui.view">
        <field name="name">pos.printer.qztray.form</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">

            <!-- Insert QZ Tray fields after the existing proxy_ip field -->
            <xpath expr="//field[@name='proxy_ip']" position="after">

                <!-- QZ Tray WebSocket connection -->
                <field name="qztray_host"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')],
                               'required': [('printer_type', '=', 'qztray')]}"/>
                <field name="qztray_port"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>

                <!-- Connection mode selector -->
                <field name="qztray_mode"
                       widget="radio"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>

                <!-- OS printer mode fields -->
                <field name="qztray_printer_name"
                       attrs="{'invisible': ['|', ('printer_type', '!=', 'qztray'),
                                                  ('qztray_mode', '!=', 'os')]}"/>

                <!-- Socket mode fields -->
                <field name="qztray_socket_ip"
                       attrs="{'invisible': ['|', ('printer_type', '!=', 'qztray'),
                                                  ('qztray_mode', '!=', 'socket')],
                               'required': [('printer_type', '=', 'qztray'),
                                            ('qztray_mode', '=', 'socket')]}"/>
                <field name="qztray_socket_port"
                       attrs="{'invisible': ['|', ('printer_type', '!=', 'qztray'),
                                                  ('qztray_mode', '!=', 'socket')]}"/>

                <!-- Shared -->
                <field name="qztray_paper_width_mm"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>

                <!-- Signing (optional) -->
                <field name="qztray_certificate"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>
                <field name="qztray_private_key"
                       password="True"
                       attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>

            </xpath>

            <!-- Add test button next to the existing buttons -->
            <xpath expr="//button[@name='action_test_connection']" position="after">
                <button name="action_test_qztray"
                        string="QZ Tray Info"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('printer_type', '!=', 'qztray')]}"/>
            </xpath>

        </field>
    </record>

</odoo>
