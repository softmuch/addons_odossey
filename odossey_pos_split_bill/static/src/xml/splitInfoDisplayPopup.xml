                <div class="col-12 border-top border-bottom border-2 text-center">
                    <h4 style="text-center: center; margin: 0px; margin-bottom: 7px;margin-top: 12px; padding: 0px; font-weight: bold;">Split</h4>
                </div>
                <div class="col-4 pt-2">
                    <div class="d-flex flex-column align-items-center"> 
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[0][0]"></b>
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[0][1]"></b>
                    </div>
                </div>
                <div class="col-4 pt-2">
                    <div class="d-flex flex-column align-items-center">
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[1][0]"></b>
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[1][1]"></b>
                    </div>
                </div>
                <div class="col-4 pt-2">
                    <div class="d-flex flex-column align-items-center">
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[2][0]"></b>
                        <b style="text-align: center; margin: 0px;" t-esc="props.body2[2][1]"></b>
                    </div>
                </div> 
            </div>
                
            <div class="row">
                <div class="col-12 border-top border-bottom border-2 text-center">
                    <h4 style="text-align: center; margin: 0px; margin-bottom: 7px;margin-top: 12px; padding: 0px; font-weight: bold;">Payment</h4>
                </div>
                <div class="col-6 pt-2">
                    <div class="d-flex flex-column align-items-center"> 
                        <b style="text-align: center; margin: 0px;" t-esc="props.body1[0][0]"></b>
                        <b style="text-align: center; margin: 0px;" t-esc="props.body1[0][1]"></b>
                    </div>
                </div>
                <div class="col-6 pt-2">
                    <div class="d-flex flex-column align-items-center">
                        <b style="text-align: center; margin: 0px;" t-esc="props.body1[1][0]"></b>
                        <b style="text-align: center; margin: 0px;" t-esc="props.body1[1][1]"></b>
                    </div>
                </div>
            </div> 
        </div> 
    </Dialog>
</t>
