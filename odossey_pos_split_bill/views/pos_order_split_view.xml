<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart button on POS order form showing the number of split invoices -->
    <record id="view_pos_order_split_invoices_button" model="ir.ui.view">
        <field name="name">pos.order.split.invoices.button</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_split_invoices"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="not split_invoice_ids"
                >
                    <field
                        name="split_invoice_ids"
                        widget="statinfo"
                        string="Split Invoices"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
