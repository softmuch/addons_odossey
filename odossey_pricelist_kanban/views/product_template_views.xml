<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_tree_view_pricelist_kanban" model="ir.ui.view">
        <field name="name">product.template.list.pricelist.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="list_price" position="after">
                <field name="pricelist_prices_html" widget="html" string="Pricelist Prices"/>
            </field>
        </field>
    </record>

    <record id="product_template_kanban_view_pricelist_kanban" model="ir.ui.view">
        <field name="name">product.template.kanban.pricelist.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[field[@name='list_price']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//span[field[@name='list_price']]" position="after">
                <div>
                    <field name="pricelist_prices_html" widget="html"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_pricelist_kanban" model="ir.ui.view">
        <field name="name">product.template.only.form.pricelist.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='list_price_uom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <label for="pricelist_prices_html" string="Pricelist Prices"/>
                <field name="pricelist_prices_html" nolabel="1" widget="html" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
