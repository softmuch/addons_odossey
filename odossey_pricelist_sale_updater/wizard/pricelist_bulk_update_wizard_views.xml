<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pricelist_bulk_update_wizard_view_form" model="ir.ui.view">
        <field name="name">pricelist.bulk.update.wizard.form</field>
        <field name="model">pricelist.bulk.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Actualización Masiva de Precios">
                <group>
                    <field name="pricelist_id" options="{'no_create': 1}"/>
                </group>
                <div class="mb-3">
                    <button name="action_download_excel" type="object"
                        string="Descargar Excel de Referencia"
                        class="btn btn-secondary"
                        invisible="not pricelist_id"/>
                </div>
                <group string="Reimportar Excel Editado">
                    <field name="import_filename" invisible="1"/>
                    <field name="import_file" filename="import_filename" string="Excel de Precios"/>
                </group>
                <footer>
                    <button name="action_import_excel" type="object"
                        string="Importar Excel"
                        class="btn btn-primary"
                        invisible="not import_file"/>
                    <button string="Cerrar" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pricelist_bulk_update_wizard" model="ir.actions.act_window">
        <field name="name">Actualización Masiva de Precios</field>
        <field name="res_model">pricelist.bulk.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
