<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_purchase_advances" model="ir.ui.view">
        <field name="name">account.move.form.inherit.purchase.advances</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_reconcile_purchase_advances" type="object"
                    string="Reconcile purchase advances"
                    invisible="move_type != 'in_invoice' or state != 'posted' or payment_state not in ('not_paid', 'partial')"
                    groups="account.group_account_invoice" />
            </xpath>
        </field>
    </record>
</odoo>
