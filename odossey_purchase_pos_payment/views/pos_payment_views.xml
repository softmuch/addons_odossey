<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_tree_inherit_purchase" model="ir.ui.view">
        <field name="name">pos.payment.list.inherit.purchase</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree" />
        <field name="arch" type="xml">
            <!-- Both columns exist on the same shared list view, but each
                 is only meaningful from one side: `pos_order_id` for a POS
                 sale payment, `purchase_order_id` for a purchase one (never
                 both on the same row). Toggled by a context flag set only
                 on the purchase-side action below, so each app's menu shows
                 only the column that applies to it. -->
            <field name="pos_order_id" position="attributes">
                <attribute name="column_invisible">context.get('purchase_payments_view')</attribute>
            </field>
            <field name="pos_order_id" position="after">
                <field name="purchase_order_id"
                    column_invisible="not context.get('purchase_payments_view')" />
            </field>
        </field>
    </record>

    <record id="view_pos_payment_form_inherit_purchase" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.purchase</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form" />
        <field name="arch" type="xml">
            <field name="pos_order_id" position="after">
                <field name="purchase_order_id" />
            </field>
        </field>
    </record>

    <record id="action_pos_payment_purchase" model="ir.actions.act_window">
        <field name="name">Pagos</field>
        <field name="res_model">pos.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('purchase_order_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_payment_method': 1, 'purchase_payments_view': 1}</field>
    </record>

    <menuitem id="menu_pos_payment_purchase" name="Pagos"
        parent="purchase.menu_procurement_management"
        action="action_pos_payment_purchase" sequence="9" />

    <!-- The POS-side "Payments" menu (Punto de Venta > Pagos) now shares
         the same pos.payment model/list with these purchase-side ones:
         restrict it to real POS sale payments only (a purchase payment
         never has a pos_order_id, see models/pos_payment.py), same as
         the purchase-side menu above is scoped the other way. Overriding
         only `domain` on the existing core action record, not replacing
         it: everything else (views, context, help text) stays core's. -->
    <record id="point_of_sale.action_pos_payment_form" model="ir.actions.act_window">
        <field name="domain">[('pos_order_id', '!=', False)]</field>
    </record>
</odoo>
