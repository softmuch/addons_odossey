<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_pay_freely_action" model="ir.actions.act_window">
        <field name="name">Pay Freely</field>
        <field name="res_model">purchase.order.pay.freely</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="purchase_order_view_tree_inherit_pay_freely" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.inherit.pay.freely</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="%(purchase_order_pay_freely_action)d"
                    type="action"
                    string="Pay Freely"
                    display="always"
                    groups="purchase.group_purchase_user"
                />
            </header>
            <field name="amount_total" position="after">
                <field name="amount_difference" widget="monetary" optional="show" string="Adeudado" sum="Adeudado" />
            </field>
        </field>
    </record>
</odoo>
