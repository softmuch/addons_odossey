<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_certificate" model="mail.template">
            <field name="name">Radio: broadcast certificate</field>
            <field name="model_id" ref="subscription_oca.model_sale_subscription"/>
            <field name="subject">Broadcast certificate {{ object.name }} - {{ object.company_id.name }}</field>
            <field name="email_to">{{ (object.radio_agency_id if object.radio_bill_to == 'agency' and object.radio_agency_id else object.partner_id).email or '' }}</field>
            <field name="body_html" type="html">
<div>
    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Please find attached the broadcast certificate of the advertising of
        <strong t-out="object.radio_campaign or object.radio_brand or object.name or ''"/>.</p>
    <p>Thank you for advertising with <t t-out="object.company_id.name or ''"/>.</p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('odossey_radio.action_report_radio_certificate'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
