#. module: odossey_radio
#: model:mail.template,body_html:odossey_radio.mail_template_certificate
msgid ""
"<div>\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>Please find attached the broadcast certificate of the advertising of\n"
"        <strong t-out=\"object.radio_campaign or object.radio_brand or object.name or ''\"/>.</p>\n"
"    <p>Thank you for advertising with <t t-out=\"object.company_id.name or ''\"/>.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div>\n"
"    <p>Buongiorno <t t-out=\"object.partner_id.name or ''\"/>,</p>\n"
"    <p>In allegato il certificato di messa in onda della pubblicità di\n"
"        <strong t-out=\"object.radio_campaign or object.radio_brand or object.name or ''\"/>.</p>\n"
"    <p>Grazie per aver scelto <t t-out=\"object.company_id.name or ''\"/>.</p>\n"
"</div>\n"
"            "

