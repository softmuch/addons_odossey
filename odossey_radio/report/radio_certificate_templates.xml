<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radio_certificate_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="doc"/>
            <div class="page" style="font-size: 12px;">
                <h3 class="text-center mb-1">Broadcast Certificate</h3>
                <p class="text-center text-muted mb-3">
                    <span t-out="doc.company_id.name"/>
                    <t t-if="doc.company_id.radio_frequency"> · <span t-out="doc.company_id.radio_frequency"/></t>
                    <t t-if="doc.company_id.radio_signal"> · <span t-out="doc.company_id.radio_signal"/></t>
                    <t t-if="doc.company_id.radio_license"> · ENACOM <span t-out="doc.company_id.radio_license"/></t>
                </p>
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td style="width: 20%;"><strong>Advertiser</strong></td>
                        <td><span t-out="doc.partner_id.name"/> <t t-if="doc.partner_id.vat">(<span t-out="doc.partner_id.vat"/>)</t></td>
                        <td style="width: 20%;"><strong>Period</strong></td>
                        <td><span t-out="date_from" t-options="{'widget': 'date'}"/> - <span t-out="date_to" t-options="{'widget': 'date'}"/></td>
                    </tr>
                    <tr>
                        <td><strong>Agency</strong></td>
                        <td><span t-out="doc.radio_agency_id.name or '-'"/></td>
                        <td><strong>Contract</strong></td>
                        <td><span t-out="doc.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Brand / Campaign</strong></td>
                        <td><span t-out="' / '.join(filter(None, [doc.radio_brand, doc.radio_campaign])) or '-'"/></td>
                        <td><strong>Advertising Order</strong></td>
                        <td><span t-out="doc.radio_op_number or '-'"/></td>
                    </tr>
                    <tr t-if="doc.radio_is_official">
                        <td><strong>Public Body</strong></td>
                        <td><span t-out="doc.radio_official_body or '-'"/></td>
                        <td><strong>Supplier Code</strong></td>
                        <td><span t-out="doc.radio_provider_code or '-'"/></td>
                    </tr>
                </table>
                <t t-set="items" t-value="lines[doc.id]"/>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr style="background-color: #eef0f5;">
                            <th>Date</th>
                            <th>Hour</th>
                            <th>Program</th>
                            <th>Format</th>
                            <th>Material</th>
                            <th class="text-end">Seconds</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="items" t-as="e">
                            <td><span t-field="e.date"/></td>
                            <td><span t-out="e.time_label"/></td>
                            <td><span t-out="e.program_id.name or ''"/></td>
                            <td><span t-out="e.format_id.name"/></td>
                            <td><span t-out="e.material_id.name or ''"/></td>
                            <td class="text-end"><span t-out="e.duration"/></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5"><strong>Total: <span t-out="len(items)"/> airings</strong></td>
                            <td class="text-end"><strong t-out="sum(items.mapped('duration'))"/></td>
                        </tr>
                    </tfoot>
                </table>
                <div class="mt-3" t-out="doc.company_id.radio_certificate_note"/>
                <div class="row mt-5">
                    <div class="col-6"/>
                    <div class="col-6 text-center">
                        <div style="border-top: 1px solid #333; margin-top: 50px; padding-top: 4px;">
                            Signature and stamp - <span t-out="doc.company_id.name"/>
                        </div>
                        <div class="text-muted">Issued on <span t-out="today" t-options="{'widget': 'date'}"/></div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_radio_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="odossey_radio.report_radio_certificate_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
