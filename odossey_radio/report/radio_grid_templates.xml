<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radio_grid">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page" style="font-size: 10px;">
                    <h4 class="text-center">Programming Grid - <span t-out="company.name"/>
                        <t t-if="company.radio_frequency"> <span t-out="company.radio_frequency"/></t></h4>
                    <table class="table table-sm table-bordered" style="table-layout: fixed;">
                        <thead>
                            <tr style="background-color: #eef0f5;">
                                <th t-foreach="grid" t-as="col" class="text-center"><span t-out="col[0].name"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td t-foreach="grid" t-as="col" style="vertical-align: top;">
                                    <div t-foreach="col[1]" t-as="program" style="border: 1px solid #ccc; border-radius: 3px; padding: 3px; margin-bottom: 4px;">
                                        <strong><span t-out="program.grid_label.split(' ')[-1]"/></strong><br/>
                                        <span t-out="program.name"/><br/>
                                        <span class="text-muted" t-out="', '.join(program.host_ids.mapped('name'))"/>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
