<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radio_log">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page" style="font-size: 11px;">
                    <t t-foreach="days" t-as="day">
                        <h4 t-att-style="'page-break-before: always;' if not day_first else ''">
                            Daily Log - <span t-out="day['date']" t-options="{'widget': 'date'}"/>
                        </h4>
                        <t t-foreach="day['blocks']" t-as="block">
                            <table class="table table-sm table-bordered mb-2">
                                <thead>
                                    <tr style="background-color: #eef0f5;">
                                        <th colspan="5">
                                            <span t-out="block['break'].name"/>
                                            <span class="float-end"><span t-out="block['seconds']"/> / <span t-out="block['break'].capacity"/> s</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="block['items']" t-as="e">
                                        <td style="width: 4%;">☐</td>
                                        <td style="width: 30%;"><span t-out="e.partner_id.name"/></td>
                                        <td style="width: 18%;"><span t-out="e.format_id.name"/></td>
                                        <td><span t-out="e.material_id.name or 'NO MATERIAL'"/></td>
                                        <td class="text-end" style="width: 8%;"><span t-out="e.duration"/>"</td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="day['orphans']">
                            <p><strong>Spots without room (to reschedule):</strong>
                                <span t-out="', '.join(day['orphans'].mapped('partner_id.name'))"/></p>
                        </t>
                        <p class="mt-3">Operator: ____________________ Signature: ____________________</p>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
