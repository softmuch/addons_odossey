<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_radio_order_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="doc"/>
            <div class="page" style="font-size: 12px;">
                <h3>Advertising Order <span t-out="doc.name"/></h3>
                <table class="table table-sm table-borderless mb-3">
                    <tr>
                        <td style="width: 20%;"><strong>Advertiser</strong></td>
                        <td><span t-out="doc.partner_id.name"/></td>
                        <td style="width: 20%;"><strong>Airing</strong></td>
                        <td><span t-out="doc.radio_date_start or doc.date_order" t-options="{'widget': 'date'}"/>
                            <t t-if="doc.radio_date_end"> - <span t-out="doc.radio_date_end" t-options="{'widget': 'date'}"/></t></td>
                    </tr>
                    <tr>
                        <td><strong>Brand / Campaign</strong></td>
                        <td><span t-out="' / '.join(filter(None, [doc.radio_brand, doc.radio_campaign])) or '-'"/></td>
                        <td><strong>Agency</strong></td>
                        <td><span t-out="doc.radio_agency_id.name or '-'"/>
                            <t t-if="doc.radio_agency_id and doc.radio_commission"> (<span t-out="doc.radio_commission"/>%)</t></td>
                    </tr>
                    <tr t-if="doc.radio_op_number or doc.client_order_ref">
                        <td><strong>Advertising Order</strong></td>
                        <td><span t-out="doc.radio_op_number or doc.client_order_ref"/></td>
                        <td/><td/>
                    </tr>
                </table>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr style="background-color: #eef0f5;">
                            <th>Format</th>
                            <th>Program / Daypart</th>
                            <th>Days</th>
                            <th class="text-end">Per day</th>
                            <th class="text-end">Seconds</th>
                            <th class="text-end">Monthly airings</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Monthly total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                            <td><span t-out="line.product_id.name"/></td>
                            <td><span t-out="line.radio_program_id.name or line.radio_daypart_id.display_name or ''"/></td>
                            <td><span t-out="', '.join(line.radio_weekday_ids.sorted('sequence').mapped('name')) or 'All'"/></td>
                            <td class="text-end"><span t-out="line.radio_spots_per_day"/></td>
                            <td class="text-end"><span t-out="line.radio_duration"/></td>
                            <td class="text-end"><span t-out="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 0}"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6">
                        <p t-if="doc.radio_seconds_per_day"><strong>Advertising per day:</strong> <span t-out="doc.radio_seconds_per_day"/> seconds</p>
                        <p t-if="doc.note" t-field="doc.note"/>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr><td>Untaxed</td><td class="text-end"><span t-field="doc.amount_untaxed"/></td></tr>
                            <tr><td>Taxes</td><td class="text-end"><span t-field="doc.amount_tax"/></td></tr>
                            <tr><td><strong>Monthly total</strong></td><td class="text-end"><strong t-field="doc.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>
                <div class="row mt-5">
                    <div class="col-6 text-center"><div style="border-top: 1px solid #333; margin-top: 40px;">Advertiser / Agency</div></div>
                    <div class="col-6 text-center"><div style="border-top: 1px solid #333; margin-top: 40px;"><span t-out="doc.company_id.name"/></div></div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_radio_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="odossey_radio.report_radio_order_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
