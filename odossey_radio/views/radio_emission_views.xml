<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="radio_emission_view_list" model="ir.ui.view">
        <field name="name">radio.emission.list</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <list string="Daily Log" editable="bottom" create="false"
                  decoration-success="state == 'aired'" decoration-danger="state in ('missed', 'conflict')"
                  decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_mark_aired" type="object" string="Aired"/>
                    <button name="action_mark_missed" type="object" string="Not Aired"/>
                    <button name="action_compensate" type="object" string="Reschedule"
                            groups="odossey_radio.group_radio_user"/>
                </header>
                <field name="date" readonly="1"/>
                <field name="time_label" string="Hour"/>
                <field name="program_id" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="subscription_id" optional="hide" readonly="1"/>
                <field name="format_id" readonly="1"/>
                <field name="duration" readonly="1" sum="Seconds"/>
                <field name="material_id" domain="[('subscription_id', '=', subscription_id), ('state', '=', 'approved')]"
                       decoration-danger="material_missing"/>
                <field name="material_missing" column_invisible="1"/>
                <field name="sequence" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="state" widget="badge" readonly="1"
                       decoration-success="state == 'aired'" decoration-info="state == 'planned'"
                       decoration-danger="state in ('missed', 'conflict')"/>
                <button name="action_mark_aired" type="object" icon="fa-check" title="Aired"
                        invisible="state not in ('planned', 'missed')"/>
                <button name="action_mark_missed" type="object" icon="fa-times" title="Not aired"
                        invisible="state not in ('planned', 'aired')"/>
                <field name="invoice_id" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="radio_emission_view_form" model="ir.ui.view">
        <field name="name">radio.emission.form</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <form string="Spot Airing" create="false">
                <header>
                    <button name="action_mark_aired" type="object" string="Aired" class="btn-primary"
                            invisible="state not in ('planned', 'missed')"/>
                    <button name="action_mark_missed" type="object" string="Not Aired"
                            invisible="state not in ('planned', 'aired')"/>
                    <button name="action_compensate" type="object" string="Reschedule"
                            invisible="state not in ('missed', 'conflict')" groups="odossey_radio.group_radio_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,aired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="break_id" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="planned_datetime"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="subscription_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="agency_id"/>
                            <field name="format_id" readonly="1"/>
                            <field name="duration" readonly="1"/>
                            <field name="material_id" domain="[('subscription_id', '=', subscription_id)]"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="aired_at"/>
                            <field name="aired_by"/>
                        </group>
                        <group>
                            <field name="compensation_of_id"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Reason, remarks..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="radio_emission_view_calendar" model="ir.ui.view">
        <field name="name">radio.emission.calendar</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <calendar string="Daily Log" date_start="planned_datetime" color="partner_id" mode="day"
                      event_open_popup="True" quick_create="False" create="False">
                <field name="partner_id" filters="1"/>
                <field name="program_id" filters="1"/>
                <field name="format_id"/>
                <field name="duration"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="radio_emission_view_pivot" model="ir.ui.view">
        <field name="name">radio.emission.pivot</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <pivot string="Airings">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="radio_emission_view_graph" model="ir.ui.view">
        <field name="name">radio.emission.graph</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <graph string="Airings" type="bar">
                <field name="date" interval="day"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="radio_emission_view_search" model="ir.ui.view">
        <field name="name">radio.emission.search</field>
        <field name="model">radio.emission</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="program_id"/>
                <field name="material_id"/>
                <field name="date"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="tomorrow" string="Tomorrow"
                        domain="[('date', '=', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="upcoming" string="Upcoming" domain="[('date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="aired" string="Aired" domain="[('state', '=', 'aired')]"/>
                <filter name="missed" string="Not Aired" domain="[('state', '=', 'missed')]"/>
                <filter name="conflict" string="No Room" domain="[('state', '=', 'conflict')]"/>
                <filter name="active_log" string="Not Cancelled" domain="[('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter name="no_material" string="Material Missing" domain="[('material_missing', '=', True), ('state', '=', 'planned')]"/>
                <group>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_program" string="Program" context="{'group_by': 'program_id'}"/>
                    <filter name="group_break" string="Break" context="{'group_by': 'break_id'}"/>
                    <filter name="group_partner" string="Advertiser" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="radio_emission_action" model="ir.actions.act_window">
        <field name="name">Airings</field>
        <field name="res_model">radio.emission</field>
        <field name="view_mode">list,calendar,pivot,graph,form</field>
        <field name="context">{'search_default_active_log': 1}</field>
    </record>

    <record id="radio_emission_today_action" model="ir.actions.act_window">
        <field name="name">Today's Log</field>
        <field name="res_model">radio.emission</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_today': 1, 'search_default_active_log': 1, 'search_default_group_program': 1, 'search_default_group_break': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No spots planned today</p>
            <p>Plan the daily log from the contracts in progress (Log > Plan the Daily Log).</p>
        </field>
    </record>

    <record id="radio_emission_conflict_action" model="ir.actions.act_window">
        <field name="name">Spots Without Room</field>
        <field name="res_model">radio.emission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('conflict', 'missed'))]</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

</odoo>
