<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="radio_certificate_wizard_view_form" model="ir.ui.view">
        <field name="name">radio.certificate.wizard.form</field>
        <field name="model">radio.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Broadcast Certificate">
                <group>
                    <group>
                        <field name="subscription_id" readonly="1"/>
                        <field name="aired_count"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="radio_certificate_wizard_action" model="ir.actions.act_window">
        <field name="name">Broadcast Certificate</field>
        <field name="res_model">radio.certificate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
