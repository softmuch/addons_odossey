<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_payment_register_form" model="ir.ui.view">
        <field name="name">sale.order.payment.register.form</field>
        <field name="model">sale.order.payment.register</field>
        <field name="arch" type="xml">
            <form string="Pagar">
                <field name="sale_order_id" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="provider_id"/>
                    <field name="payment_method_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="reference" placeholder="Auto-generada"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmar Pago" type="object"
                            class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
