<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hours detail appended to the quotation / invoice: expects `hours`, the dict
         returned by _get_report_timesheets() -->
    <template id="report_hours_sections">
        <div style="page-break-before: always;" name="hours_detail">
            <h2 class="mt-3">Hours Detail</h2>
            <t t-set="show_task" t-value="True"/>
            <t t-if="hours['invoiced']">
                <h5 class="mt-4" name="hours_invoiced_title">Invoiced hours</h5>
                <t t-set="lines" t-value="hours['invoiced']"/>
                <t t-call="hr_timesheet.timesheet_table"/>
            </t>
            <t t-if="hours['maintenance']">
                <h5 class="mt-4" name="hours_maintenance_title">Maintenance hours (not invoiced)</h5>
                <t t-set="lines" t-value="hours['maintenance']"/>
                <t t-call="hr_timesheet.timesheet_table"/>
            </t>
        </div>
    </template>

    <template id="report_saleorder_document_hours" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="print_with_hours">
                <t t-set="hours" t-value="doc._get_report_timesheets()"/>
                <t t-if="hours['invoiced'] or hours['maintenance']"
                   t-call="odossey_timesheet_to_invoice.report_hours_sections"/>
            </t>
        </xpath>
    </template>

    <template id="report_saleorder_hours">
        <t t-call="sale.report_saleorder_raw">
            <t t-set="print_with_hours" t-value="True"/>
        </t>
    </template>

    <template id="report_invoice_document_hours" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="print_with_hours">
                <t t-set="hours" t-value="o._get_report_timesheets()"/>
                <t t-if="hours['invoiced'] or hours['maintenance']"
                   t-call="odossey_timesheet_to_invoice.report_hours_sections"/>
            </t>
        </xpath>
    </template>

    <template id="report_invoice_hours">
        <t t-call="account.report_invoice">
            <t t-set="print_with_payments" t-value="True"/>
            <t t-set="print_with_hours" t-value="True"/>
        </t>
    </template>

</odoo>
