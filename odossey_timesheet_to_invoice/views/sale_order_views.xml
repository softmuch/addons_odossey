<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.to.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="qty_extra" optional="show" invisible="display_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//label[@for='qty_delivered']" position="before">
                <label for="qty_extra"/>
                <div name="extra_qty">
                    <field name="qty_extra"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
