<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- `timesheet_noise` ({timesheet id: hours to print}) is only set by the
         "+ Hours" reports: every other timesheet report prints the recorded hours -->
    <template id="timesheet_table" inherit_id="hr_timesheet.timesheet_table">
        <xpath expr="//span[@t-field='line.unit_amount']" position="replace">
            <span t-if="not is_uom_day and timesheet_noise and line.id in timesheet_noise"
                  t-out="timesheet_noise[line.id]"
                  t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}">2 hours</span>
            <span t-elif="not is_uom_day" t-field="line.unit_amount" t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}">2 hours</span>
        </xpath>
    </template>

    <template id="report_hours_sections" inherit_id="odossey_timesheet_to_invoice.report_hours_sections">
        <xpath expr="//t[@t-set='show_task']" position="after">
            <t t-set="timesheet_noise" t-value="hours.get('noise')"/>
        </xpath>
    </template>

</odoo>
