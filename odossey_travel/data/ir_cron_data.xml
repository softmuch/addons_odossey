<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <record id="ir_cron_travel_birthday" model="ir.cron">
        <field name="name">Travel: Send Birthday Emails</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_travel_send_birthday_emails()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
    </record>
    </data>

    <record id="ir_cron_travel_birthday_action" model="ir.actions.act_window">
        <field name="name">Birthday Emails</field>
        <field name="res_model">ir.cron</field>
        <field name="res_id" ref="ir_cron_travel_birthday"/>
        <field name="view_mode">form</field>
    </record>
</odoo>
