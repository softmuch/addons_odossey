#. module: odossey_travel
#: model:mail.template,body_html:odossey_travel.mail_template_birthday
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"font-size: 22px; font-weight: bold; margin: 0px 0px 16px 0px;\">\n"
"        Happy birthday, <t t-out=\"object.name or ''\">Juan</t>!\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        The whole team of <t t-out=\"(object.company_id or object.env.company).name or ''\">YourCompany</t> wishes you a wonderful day full of joy.\n"
"        May this new year bring you many unforgettable trips!\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        We look forward to planning your next adventure together.\n"
"    </p>\n"
"    <p style=\"margin: 0px;\">\n"
"        Warm regards,<br/>\n"
"        <t t-out=\"(object.company_id or object.env.company).name or ''\">YourCompany</t>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p style=\"font-size: 22px; font-weight: bold; margin: 0px 0px 16px 0px;\">\n"
"        ¡Feliz cumpleaños, <t t-out=\"object.name or ''\">Juan</t>!\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        Todo el equipo de <t t-out=\"(object.company_id or object.env.company).name or ''\">YourCompany</t> te desea un día maravilloso lleno de alegría.\n"
"        ¡Que este nuevo año te traiga muchos viajes inolvidables!\n"
"    </p>\n"
"    <p style=\"margin: 0px 0px 16px 0px;\">\n"
"        Esperamos planificar juntos tu próxima aventura.\n"
"    </p>\n"
"    <p style=\"margin: 0px;\">\n"
"        Saludos cordiales,<br/>\n"
"        <t t-out=\"(object.company_id or object.env.company).name or ''\">YourCompany</t>\n"
"    </p>\n"
"</div>\n"
"            "

