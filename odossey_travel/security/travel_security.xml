<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_travel" model="ir.module.category">
        <field name="name">Travel</field>
        <field name="sequence">17</field>
    </record>

    <record id="privilege_travel" model="res.groups.privilege">
        <field name="name">Travel</field>
        <field name="description">Access level for the Travel application.</field>
        <field name="placeholder">No Access</field>
        <field name="category_id" ref="module_category_travel"/>
        <field name="sequence">17</field>
    </record>

    <record id="group_travel_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_travel"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads')),
                                         Command.link(ref('account.group_account_invoice'))]"/>
        <field name="comment">Manages trips, bookings, groups and passengers.</field>
    </record>

    <record id="group_travel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_travel"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_travel_user')),
                                         Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Also accesses the forecast, the net profitability and the configuration.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="travel_trip_company_rule" model="ir.rule">
        <field name="name">Trip: multi-company</field>
        <field name="model_id" ref="model_travel_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="travel_activity_company_rule" model="ir.rule">
        <field name="name">Trip activity: multi-company</field>
        <field name="model_id" ref="model_travel_activity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="travel_passenger_company_rule" model="ir.rule">
        <field name="name">Passenger: multi-company</field>
        <field name="model_id" ref="model_travel_passenger"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="travel_group_company_rule" model="ir.rule">
        <field name="name">Travel group: multi-company</field>
        <field name="model_id" ref="model_travel_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="travel_cancellation_policy_company_rule" model="ir.rule">
        <field name="name">Cancellation policy: multi-company</field>
        <field name="model_id" ref="model_travel_cancellation_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="travel_forecast_report_company_rule" model="ir.rule">
        <field name="name">Travel forecast: multi-company</field>
        <field name="model_id" ref="model_travel_forecast_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="travel_profitability_report_company_rule" model="ir.rule">
        <field name="name">Travel profitability: multi-company</field>
        <field name="model_id" ref="model_travel_profitability_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
