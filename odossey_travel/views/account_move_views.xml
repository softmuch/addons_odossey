<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_travel" model="ir.ui.view">
        <field name="name">account.move.form.travel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="trip_id" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                       readonly="state != 'draft'" options="{'no_create': True}"/>
                <field name="travel_group_id" invisible="not trip_id or move_type not in ('out_invoice', 'out_refund')"
                       readonly="state != 'draft'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_search_travel" model="ir.ui.view">
        <field name="name">account.move.search.travel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="trip_id"/>
                <field name="travel_group_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="group_by_trip" string="Trip" context="{'group_by': 'trip_id'}"/>
                <filter name="group_by_group" string="Travel Group" context="{'group_by': 'travel_group_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_list_travel" model="ir.ui.view">
        <field name="name">account.move.list.travel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="trip_id" optional="hide"/>
                <field name="travel_group_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="travel_invoice_action" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('trip_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_group_by_trip': 1}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No travel invoices yet</p>
            <p>Invoices created from bookings are linked to their trip and travel group.</p>
        </field>
    </record>

    <record id="travel_bill_action" model="ir.actions.act_window">
        <field name="name">Supplier Costs</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_group_by_trip': 1}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a supplier bill</p>
            <p>Link the bills of hotels, airlines and operators to the trip to compute its net profitability.</p>
        </field>
    </record>
</odoo>
