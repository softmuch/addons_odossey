<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_travel" model="ir.ui.view">
        <field name="name">crm.lead.form.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']/.." position="after">
                <field name="trip_id" options="{'no_quick_create': True}"/>
                <field name="travel_destination" invisible="trip_id"/>
                <field name="travel_pax_count"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_list_travel" model="ir.ui.view">
        <field name="name">crm.lead.list.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="trip_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="crm_lead_view_search_travel" model="ir.ui.view">
        <field name="name">crm.lead.search.travel</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="trip_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="group_by_trip" string="Trip" context="{'group_by': 'trip_id'}"/>
                <filter name="group_by_won_status" string="Won / Lost" context="{'group_by': 'won_status'}"/>
            </xpath>
        </field>
    </record>

    <record id="travel_crm_lead_view_graph" model="ir.ui.view">
        <field name="name">crm.lead.graph.travel</field>
        <field name="model">crm.lead</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Won / Lost Opportunities" type="bar" stacked="1" sample="1">
                <field name="won_status"/>
                <field name="lost_reason_id"/>
            </graph>
        </field>
    </record>

    <record id="travel_crm_lead_view_pivot" model="ir.ui.view">
        <field name="name">crm.lead.pivot.travel</field>
        <field name="model">crm.lead</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Won / Lost Opportunities" sample="1">
                <field name="trip_id" type="row"/>
                <field name="won_status" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="travel_crm_lead_action" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a travel opportunity</p>
            <p>Track the trips your prospects are interested in and turn them into bookings.</p>
        </field>
    </record>

    <record id="travel_crm_won_lost_action" model="ir.actions.act_window">
        <field name="name">Won / Lost Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="domain">[('type', '=', 'opportunity'), ('won_status', 'in', ('won', 'lost'))]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No closed opportunities yet</p>
            <p>Won and lost opportunities (with their lost reasons) appear here.</p>
        </field>
    </record>
    <record id="travel_crm_won_lost_action_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="travel_crm_lead_view_graph"/>
        <field name="act_window_id" ref="travel_crm_won_lost_action"/>
    </record>
    <record id="travel_crm_won_lost_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="travel_crm_lead_view_pivot"/>
        <field name="act_window_id" ref="travel_crm_won_lost_action"/>
    </record>
</odoo>
