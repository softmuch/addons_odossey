<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="travel_cancellation_policy_view_form" model="ir.ui.view">
        <field name="name">travel.cancellation.policy.form</field>
        <field name="model">travel.cancellation.policy</field>
        <field name="arch" type="xml">
            <form string="Cancellation Policy">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard group trip"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="deposit_refundable"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="rule_ids">
                        <list editable="bottom">
                            <field name="days_before"/>
                            <field name="penalty_percent"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Conditions printed on quotations..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="travel_cancellation_policy_view_list" model="ir.ui.view">
        <field name="name">travel.cancellation.policy.list</field>
        <field name="model">travel.cancellation.policy</field>
        <field name="arch" type="xml">
            <list string="Cancellation Policies">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="deposit_refundable"/>
                <field name="rule_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="travel_cancellation_policy_action" model="ir.actions.act_window">
        <field name="name">Cancellation Policies</field>
        <field name="res_model">travel.cancellation.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
