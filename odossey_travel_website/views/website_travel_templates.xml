<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Catalogue ============ -->
    <template id="trip_card" name="Trip Card">
        <t t-set="card_prices" t-value="trip._web_price_values()"/>
        <div class="card h-100 shadow-sm border-0 o_travel_trip_card">
            <a t-att-href="trip.website_url" class="text-decoration-none">
                <img t-if="trip.image_1920" t-att-src="image_data_uri(trip.image_1024)"
                     class="card-img-top object-fit-cover" style="height: 190px;" t-att-alt="trip.name"/>
                <div t-else="" class="card-img-top d-flex align-items-center justify-content-center bg-primary-subtle"
                     style="height: 190px;">
                    <i class="fa fa-plane fa-3x text-primary" title="Trip"/>
                </div>
            </a>
            <div class="card-body d-flex flex-column">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <span class="badge rounded-pill text-bg-light" t-field="trip.trip_type"/>
                    <span t-if="not trip.web_seats_available" class="badge rounded-pill text-bg-danger">Sold out</span>
                    <span t-elif="trip.web_seats_available &lt;= 5" class="badge rounded-pill text-bg-warning">
                        <t t-out="trip.web_seats_available"/> seats left
                    </span>
                </div>
                <h5 class="card-title mb-1">
                    <a t-att-href="trip.website_url" class="text-reset text-decoration-none" t-field="trip.name"/>
                </h5>
                <div class="text-muted small mb-2">
                    <i class="fa fa-map-marker me-1" title="Destination"/><t t-out="trip.destination"/>
                </div>
                <div class="small mb-3">
                    <i class="fa fa-calendar me-1" title="Dates"/>
                    <span t-field="trip.date_start"/> - <span t-field="trip.date_end"/>
                    <span class="text-muted">(<t t-out="trip.nights"/> nights)</span>
                </div>
                <div class="mt-auto d-flex align-items-end justify-content-between">
                    <div>
                        <div class="text-muted small">Per person</div>
                        <div class="fs-4 fw-bold">
                            <span t-out="card_prices['price']"
                                  t-options="{'widget': 'monetary', 'display_currency': card_prices['currency']}"/>
                            <small t-if="card_prices['currency'] != trip.company_id.currency_id"
                                   class="fs-6 text-muted" t-out="card_prices['currency'].name"/>
                        </div>
                        <div t-if="card_prices['deposit'] and trip.web_bookable" class="small text-success">
                            Book with <t t-out="card_prices['deposit']"
                                         t-options="{'widget': 'monetary', 'display_currency': card_prices['currency']}"/>
                        </div>
                    </div>
                    <a t-att-href="trip.website_url" class="btn btn-primary">See trip</a>
                </div>
            </div>
        </div>
    </template>

    <template id="trips_page" name="Trips">
        <t t-call="website.layout">
            <t t-set="additional_title">Trips</t>
            <div id="wrap" class="o_travel_trips">
                <section class="py-5 bg-primary-subtle">
                    <div class="container">
                        <h1 class="display-5 fw-bold mb-2">Our trips</h1>
                        <p class="lead mb-4">Book online with a deposit and freeze the price of your trip.</p>
                        <form action="/viajes" method="get" class="row g-2 align-items-end">
                            <div class="col-12 col-md-5">
                                <label class="form-label small" for="travel_search">Destination</label>
                                <input type="search" id="travel_search" name="search" class="form-control"
                                       t-att-value="search" placeholder="Where do you want to go?"/>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small" for="travel_month">Departure</label>
                                <select id="travel_month" name="month" class="form-select">
                                    <option value="">Any month</option>
                                    <t t-foreach="months" t-as="m">
                                        <option t-att-value="m" t-att-selected="m == month"
                                                t-out="m[5:] + '/' + m[:4]"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small" for="travel_type">Type</label>
                                <select id="travel_type" name="trip_type" class="form-select">
                                    <option value="">All</option>
                                    <option value="national" t-att-selected="trip_type == 'national'">National</option>
                                    <option value="international" t-att-selected="trip_type == 'international'">International</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-2 d-grid">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search me-1" title="Search"/>Search</button>
                            </div>
                        </form>
                    </div>
                </section>
                <section class="py-5">
                    <div class="container">
                        <div t-if="not trips" class="text-center text-muted py-5">
                            <i class="fa fa-compass fa-3x mb-3" title="No trips"/>
                            <p class="lead">No trips match your search.</p>
                            <a href="/viajes" class="btn btn-link">See all trips</a>
                        </div>
                        <div class="row g-4">
                            <div t-foreach="trips" t-as="trip" class="col-12 col-md-6 col-lg-4">
                                <t t-call="odossey_travel_website.trip_card"/>
                            </div>
                        </div>
                        <div class="d-flex justify-content-center mt-4">
                            <t t-call="website.pager"/>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============ Trip page ============ -->
    <template id="trip_page" name="Trip Page">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="trip.name"/>
            <div id="wrap" class="o_travel_trip_page">
                <section class="py-4 bg-primary-subtle">
                    <div class="container">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-2">
                                <li class="breadcrumb-item"><a href="/viajes">Trips</a></li>
                                <li class="breadcrumb-item active" aria-current="page" t-out="trip.name"/>
                            </ol>
                        </nav>
                        <h1 class="display-6 fw-bold mb-1" t-field="trip.name"/>
                        <div class="text-muted">
                            <i class="fa fa-map-marker me-1" title="Destination"/><t t-out="trip.destination"/>
                            <span class="mx-2">·</span>
                            <i class="fa fa-calendar me-1" title="Dates"/><span t-field="trip.date_start"/> - <span t-field="trip.date_end"/>
                            (<t t-out="trip.nights"/> nights)
                        </div>
                    </div>
                </section>
                <section class="py-4">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-12 col-lg-8">
                                <img t-if="trip.image_1920" t-att-src="image_data_uri(trip.image_1920)"
                                     class="img-fluid rounded-3 mb-4 w-100 object-fit-cover" style="max-height: 420px;"
                                     t-att-alt="trip.name"/>
                                <div class="d-flex flex-wrap gap-2 mb-4">
                                    <span t-if="trip.includes_flight" class="badge rounded-pill text-bg-primary px-3 py-2"><i class="fa fa-plane me-1" title="Flights"/>Flights</span>
                                    <span t-if="trip.includes_lodging" class="badge rounded-pill text-bg-primary px-3 py-2"><i class="fa fa-bed me-1" title="Lodging"/>Lodging</span>
                                    <span t-if="trip.includes_transfer" class="badge rounded-pill text-bg-primary px-3 py-2"><i class="fa fa-bus me-1" title="Transfers"/>Transfers</span>
                                    <span t-if="trip.includes_excursions" class="badge rounded-pill text-bg-primary px-3 py-2"><i class="fa fa-map me-1" title="Excursions"/>Excursions</span>
                                    <span t-if="trip.includes_assistance" class="badge rounded-pill text-bg-primary px-3 py-2"><i class="fa fa-medkit me-1" title="Travel assistance"/>Travel assistance</span>
                                </div>
                                <div t-if="trip.website_description" t-field="trip.website_description" class="mb-4"/>
                                <div t-elif="trip.description" t-field="trip.description" class="mb-4"/>
                                <p t-if="trip.not_included" class="text-muted">
                                    <b>Not included:</b> <t t-out="trip.not_included"/>
                                </p>
                                <t t-if="itinerary">
                                    <h3 class="h4 mt-4 mb-3">Itinerary</h3>
                                    <ul class="list-group list-group-flush mb-4">
                                        <li t-foreach="itinerary" t-as="step" class="list-group-item px-0">
                                            <div class="d-flex gap-3">
                                                <div class="text-primary" style="width: 1.5rem;">
                                                    <i t-att-class="'fa fa-' + {'flight': 'plane', 'lodging': 'bed', 'transfer': 'bus', 'excursion': 'map', 'meeting': 'users'}.get(step.activity_type, 'circle')"
                                                       t-att-title="step.activity_type"/>
                                                </div>
                                                <div>
                                                    <div class="fw-bold" t-out="step.name"/>
                                                    <div class="small text-muted">
                                                        <span t-field="step.start" t-options="{'widget': 'date'}"/>
                                                        <t t-if="step.carrier"> · <t t-out="step.carrier"/> <t t-out="step.flight_number or ''"/></t>
                                                        <t t-if="step.route"> · <t t-out="step.route"/></t>
                                                        <t t-if="step.hotel_stars"> · <span t-field="step.hotel_stars"/></t>
                                                        <t t-if="step.board_basis"> · <span t-field="step.board_basis"/></t>
                                                        <t t-if="step.location"> · <t t-out="step.location"/></t>
                                                    </div>
                                                    <div t-if="step.note" t-field="step.note" class="small"/>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </t>
                                <h3 class="h4 mt-4 mb-3">Conditions</h3>
                                <div t-field="trip.conditions" class="small"/>
                                <div t-if="trip.cancellation_policy_id.note" t-field="trip.cancellation_policy_id.note" class="small text-muted"/>
                            </div>
                            <div class="col-12 col-lg-4">
                                <div class="card border-0 shadow-sm position-sticky" style="top: 90px;">
                                    <div class="card-body">
                                        <div class="text-muted small">Price per person</div>
                                        <div class="display-6 fw-bold">
                                            <span t-out="prices['price']"
                                                  t-options="{'widget': 'monetary', 'display_currency': prices['currency']}"/>
                                            <small t-if="prices['currency'] != trip.company_id.currency_id"
                                                   class="fs-5 text-muted" t-out="prices['currency'].name"/>
                                        </div>
                                        <div t-if="prices['converted']" class="small text-muted">
                                            (<t t-out="trip.currency_id.name"/> <t t-out="prices['trip_price']" t-options="{'widget': 'monetary', 'display_currency': trip.currency_id}"/>
                                            at today's exchange rate)
                                        </div>
                                        <div t-if="not trip.web_bookable"/>
                                        <div t-elif="prices['deposit']" class="alert alert-success mt-3 mb-3 py-2">
                                            <i class="fa fa-lock me-1" title="Price frozen"/>
                                            Book now with <b t-out="prices['deposit']"
                                                             t-options="{'widget': 'monetary', 'display_currency': prices['currency']}"/>
                                            per person and <b>freeze the price</b>.
                                            Balance due before <span t-field="trip.balance_due_date"/>.
                                        </div>
                                        <div t-else="" class="alert alert-info mt-3 mb-3 py-2">
                                            The full amount is paid online when booking.
                                        </div>
                                        <t t-if="trip.web_bookable">
                                            <form t-att-action="trip.website_url + '/reservar'" method="get">
                                                <label class="form-label small" for="travel_pax">Passengers</label>
                                                <div class="input-group mb-3">
                                                    <select id="travel_pax" name="pax" class="form-select">
                                                        <t t-foreach="range(1, min(trip.web_max_pax, trip.web_seats_available) + 1)" t-as="n">
                                                            <option t-att-value="n" t-out="n"/>
                                                        </t>
                                                    </select>
                                                    <button type="submit" class="btn btn-primary">Book now</button>
                                                </div>
                                            </form>
                                            <div class="small text-muted">
                                                <i class="fa fa-users me-1" title="Seats"/>
                                                <t t-out="trip.web_seats_available"/> seats available
                                            </div>
                                        </t>
                                        <div t-elif="not trip.web_seats_available" class="alert alert-danger mt-3 mb-0">
                                            <b>Sold out.</b> Contact us to join the waiting list.
                                        </div>
                                        <div t-else="" class="alert alert-warning mt-3 mb-0">
                                            This trip cannot be booked online anymore. Contact us!
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============ Booking form ============ -->
    <template id="trip_booking_page" name="Trip Booking">
        <t t-call="website.layout">
            <t t-set="additional_title">Booking</t>
            <div id="wrap" class="o_travel_booking">
                <section class="py-5">
                    <div class="container" style="max-width: 960px;">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/viajes">Trips</a></li>
                                <li class="breadcrumb-item"><a t-att-href="trip.website_url" t-out="trip.name"/></li>
                                <li class="breadcrumb-item active" aria-current="page">Booking</li>
                            </ol>
                        </nav>
                        <h1 class="h2 mb-1">Book <t t-out="trip.name"/></h1>
                        <p class="text-muted"><span t-field="trip.date_start"/> - <span t-field="trip.date_end"/> · <t t-out="trip.destination"/></p>
                        <div t-if="error" class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                            <i class="fa fa-exclamation-triangle" title="Error"/><t t-out="error"/>
                        </div>
                        <form t-att-action="trip.website_url + '/reservar'" method="post" class="o_travel_booking_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row g-4">
                                <div class="col-12 col-lg-8">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body">
                                            <h2 class="h5 mb-3">Holder of the booking</h2>
                                            <div class="row g-3">
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label" for="name">Full name</label>
                                                    <input type="text" id="name" name="name" class="form-control" required="1"
                                                           t-att-value="post.get('name') or partner.name"/>
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label" for="email">Email</label>
                                                    <input type="email" id="email" name="email" class="form-control" required="1"
                                                           t-att-value="post.get('email') or partner.email"/>
                                                </div>
                                                <div class="col-12 col-md-4">
                                                    <label class="form-label" for="phone">Phone</label>
                                                    <input type="tel" id="phone" name="phone" class="form-control"
                                                           t-att-value="post.get('phone') or partner.phone"/>
                                                </div>
                                                <div class="col-6 col-md-3">
                                                    <label class="form-label" for="id_type_id">Document</label>
                                                    <select id="id_type_id" name="id_type_id" class="form-select">
                                                        <t t-foreach="id_types" t-as="id_type">
                                                            <option t-att-value="id_type.id" t-out="id_type.name"
                                                                    t-att-selected="str(id_type.id) == post.get('id_type_id') or (not post.get('id_type_id') and (partner.l10n_latam_identification_type_id == id_type if partner.l10n_latam_identification_type_id else id_type.name == 'DNI'))"/>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div class="col-6 col-md-5">
                                                    <label class="form-label" for="vat">Number</label>
                                                    <input type="text" id="vat" name="vat" class="form-control" required="1"
                                                           t-att-value="post.get('vat') or partner.vat"/>
                                                </div>
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label" for="responsibility_id">VAT condition</label>
                                                    <select id="responsibility_id" name="responsibility_id" class="form-select">
                                                        <t t-foreach="responsibilities" t-as="resp">
                                                            <option t-att-value="resp.id" t-out="resp.name"
                                                                    t-att-selected="str(resp.id) == post.get('responsibility_id') or (not post.get('responsibility_id') and (partner.l10n_ar_afip_responsibility_type_id == resp if partner.l10n_ar_afip_responsibility_type_id else resp.code == '5'))"/>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div class="col-12 col-md-6 d-flex align-items-end">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="holder_travels" name="holder_travels"
                                                               t-att-checked="post.get('holder_travels', '1') and 'checked'" value="1"/>
                                                        <label class="form-check-label" for="holder_travels">The holder is passenger 1</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <h2 class="h5 mb-0">Passengers</h2>
                                                <div class="d-flex align-items-center gap-2">
                                                    <label class="small text-muted" for="pax_select">Number</label>
                                                    <select id="pax_select" class="form-select form-select-sm w-auto"
                                                            onchange="window.location.search = '?pax=' + this.value">
                                                        <t t-foreach="range(1, max_pax + 1)" t-as="n">
                                                            <option t-att-value="n" t-out="n" t-att-selected="n == pax"/>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>
                                            <input type="hidden" name="pax" t-att-value="pax"/>
                                            <t t-foreach="range(pax)" t-as="i">
                                                <div class="row g-2 mb-3 o_travel_passenger_row">
                                                    <div class="col-12 small fw-bold text-muted">Passenger <t t-out="i + 1"/></div>
                                                    <div class="col-12 col-md-5">
                                                        <input t-if="i == 0" type="text" class="form-control" name="passenger_0_name"
                                                               placeholder="Same as the holder if empty"
                                                               t-att-value="post.get('passenger_0_name') or partner.name or ''"/>
                                                        <input t-else="" type="text" class="form-control" t-att-name="'passenger_%s_name' % i"
                                                               placeholder="Full name (as in the ID)" required="1"
                                                               t-att-value="post.get('passenger_%s_name' % i) or ''"/>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <input type="text" class="form-control" t-att-name="'passenger_%s_vat' % i"
                                                               placeholder="DNI / Passport"
                                                               t-att-value="post.get('passenger_%s_vat' % i) or (i == 0 and partner.vat) or ''"/>
                                                    </div>
                                                    <div class="col-6 col-md-4">
                                                        <input type="date" class="form-control" t-att-name="'passenger_%s_birthdate' % i"
                                                               title="Birthdate" t-att-value="post.get('passenger_%s_birthdate' % i) or ''"/>
                                                    </div>
                                                </div>
                                            </t>
                                            <div class="row g-3">
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label" for="room_type">Room</label>
                                                    <select id="room_type" name="room_type" class="form-select">
                                                        <t t-foreach="room_types" t-as="room">
                                                            <option t-att-value="room[0]" t-out="room[1]"
                                                                    t-att-selected="room[0] == (post.get('room_type') or 'double')"/>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label" for="notes">Comments (dietary restrictions, special requests...)</label>
                                                    <textarea id="notes" name="notes" class="form-control" rows="2" t-out="post.get('notes') or ''"/>
                                                </div>
                                            </div>
                                            <p class="small text-muted mt-3 mb-0">
                                                Passport data can be completed later from your customer account.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <div class="card border-0 shadow-sm position-sticky" style="top: 90px;">
                                        <div class="card-body">
                                            <h2 class="h5">Summary</h2>
                                            <table class="table table-sm mb-3">
                                                <tr>
                                                    <td>Price per person</td>
                                                    <td class="text-end"><span t-out="prices['price']" t-options="{'widget': 'monetary', 'display_currency': prices['currency']}"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Passengers</td>
                                                    <td class="text-end" t-out="pax"/>
                                                </tr>
                                                <tr class="fw-bold">
                                                    <td>Total (approx.)</td>
                                                    <td class="text-end"><span t-out="prices['price'] * pax" t-options="{'widget': 'monetary', 'display_currency': prices['currency']}"/>
                                                        <small t-if="prices['currency'] != trip.company_id.currency_id" class="text-muted" t-out="prices['currency'].name"/></td>
                                                </tr>
                                                <tr t-if="prices['deposit']" class="text-success">
                                                    <td>Deposit to pay now</td>
                                                    <td class="text-end"><span t-out="prices['deposit'] * pax" t-options="{'widget': 'monetary', 'display_currency': prices['currency']}"/></td>
                                                </tr>
                                            </table>
                                            <p t-if="prices['deposit']" class="small">
                                                <i class="fa fa-lock me-1" title="Price frozen"/>
                                                On the next step you choose to pay the deposit (it freezes the price) or the full amount.
                                            </p>
                                            <div class="form-check mb-3">
                                                <input type="checkbox" class="form-check-input" id="accept_conditions" name="accept_conditions" value="1" required="1"/>
                                                <label class="form-check-label small" for="accept_conditions">
                                                    I accept the booking conditions and the cancellation policy of the trip
                                                    (<a t-att-href="trip.website_url" target="_blank">see conditions</a>).
                                                </label>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100 o_travel_booking_submit">
                                                Continue to payment <i class="fa fa-arrow-right ms-1" title="Continue"/>
                                            </button>
                                            <p class="small text-muted mt-3 mb-0">
                                                Seats are held for <t t-out="trip.quotation_validity_hours"/> hours until the payment.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- ============ Withdrawal (botón de arrepentimiento) ============ -->
    <template id="withdrawal_page" name="Withdrawal Button">
        <t t-call="website.layout">
            <t t-set="additional_title">Withdrawal button</t>
            <div id="wrap">
                <section class="py-5">
                    <div class="container" style="max-width: 640px;">
                        <h1 class="h2">Withdrawal button</h1>
                        <p class="text-muted">
                            If you booked online you can withdraw from the purchase within 10 calendar days
                            (Argentinian consumer protection rules). Enter your booking reference and email.
                        </p>
                        <div t-if="done" class="alert alert-success" role="alert">
                            <i class="fa fa-check me-1" title="Done"/>
                            Your request has been registered. Request code: <b t-out="code"/>.
                            We will contact you shortly.
                        </div>
                        <t t-else="">
                            <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                            <form action="/viajes/arrepentimiento" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label class="form-label" for="reference">Booking reference</label>
                                    <input type="text" id="reference" name="reference" class="form-control" required="1"
                                           placeholder="e.g. S00042" t-att-value="post.get('reference')"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="w_email">Email</label>
                                    <input type="email" id="w_email" name="email" class="form-control" required="1"
                                           t-att-value="post.get('email')"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="reason">Reason (optional)</label>
                                    <textarea id="reason" name="reason" class="form-control" rows="3" t-out="post.get('reason') or ''"/>
                                </div>
                                <button type="submit" class="btn btn-primary">Send withdrawal request</button>
                            </form>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Footer link to the withdrawal button (mandatory for online sales in Argentina) -->
    <template id="footer_withdrawal_link" inherit_id="website.layout" name="Travel: withdrawal link">
        <xpath expr="//footer" position="inside">
            <div class="container text-center small py-2 o_travel_withdrawal_link">
                <a href="/viajes/arrepentimiento">Botón de arrepentimiento</a>
            </div>
        </xpath>
    </template>
</odoo>
