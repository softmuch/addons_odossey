#. module: odossey_veterinary
#: model:mail.template,body_html:odossey_veterinary.mail_template_preventive_reminder
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Hello <t t-out=\"object.name or ''\">Ana</t>,</p>\n"
"    <p>This is a reminder of the preventive care of your pets that is due soon:</p>\n"
"    <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"        <tr>\n"
"            <th style=\"text-align: left; padding: 4px 12px 4px 0;\">Patient</th>\n"
"            <th style=\"text-align: left; padding: 4px 12px 4px 0;\">Treatment</th>\n"
"            <th style=\"text-align: left; padding: 4px 0;\">Due date</th>\n"
"        </tr>\n"
"        <t t-foreach=\"object.vet_pet_ids._vet_due_preventive()\" t-as=\"rec\">\n"
"            <tr>\n"
"                <td style=\"padding: 4px 12px 4px 0;\" t-out=\"rec.pet_id.name\">Firulais</td>\n"
"                <td style=\"padding: 4px 12px 4px 0;\" t-out=\"rec.product_id.name\">Rabies vaccine</td>\n"
"                <td style=\"padding: 4px 0;\" t-out=\"format_date(rec.next_date)\">01/12/2026</td>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p>Reply to this email or call us to book an appointment.</p>\n"
"    <p>Best regards,<br/><t t-out=\"(object.company_id or user.company_id).name or ''\">The clinic</t></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Hola <t t-out=\"object.name or ''\">Ana</t>,</p>\n"
"    <p>Te recordamos los cuidados preventivos de tus mascotas que vencen pronto:</p>\n"
"    <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"        <tr>\n"
"            <th style=\"text-align: left; padding: 4px 12px 4px 0;\">Paciente</th>\n"
"            <th style=\"text-align: left; padding: 4px 12px 4px 0;\">Tratamiento</th>\n"
"            <th style=\"text-align: left; padding: 4px 0;\">Vencimiento</th>\n"
"        </tr>\n"
"        <t t-foreach=\"object.vet_pet_ids._vet_due_preventive()\" t-as=\"rec\">\n"
"            <tr>\n"
"                <td style=\"padding: 4px 12px 4px 0;\" t-out=\"rec.pet_id.name\">Firulais</td>\n"
"                <td style=\"padding: 4px 12px 4px 0;\" t-out=\"rec.product_id.name\">Vacuna antirrábica</td>\n"
"                <td style=\"padding: 4px 0;\" t-out=\"format_date(rec.next_date)\">01/12/2026</td>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p>Respondé este email o llamanos para reservar un turno.</p>\n"
"    <p>Saludos cordiales,<br/><t t-out=\"(object.company_id or user.company_id).name or ''\">La clínica</t></p>\n"
"</div>\n"
"        "

