<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Agenda cell: time, patient (species, alerts), owner and phone, veterinarian, reason and status -->
    <t t-name="odossey_veterinary.VetCalendarEvent">
        <t t-set="r" t-value="rawRecord"/>
        <div t-attf-class="o_vet_event {{ vetCard.status ? 'o_vet_event_has_status' : '' }} {{ vetCard.species and r.vet_card_species_icon ? 'o_vet_event_has_icon' : '' }}">
            <div class="o_vet_event_head">
                <span t-if="!isTimeHidden" class="fc-time o_vet_event_time" t-esc="startTime"/>
                <i t-if="vetCard.alerts and r.vet_card_danger_alert" class="fa fa-exclamation-triangle o_vet_event_alert" t-att-title="r.vet_card_danger_alert"/>
                <b class="o_vet_event_pet" t-esc="r.vet_card_pet or title"/>
                <span t-if="vetCard.species and r.vet_card_species" class="o_vet_event_species" t-esc="'(' + r.vet_card_species + ')'"/>
                <span t-if="r.vet_is_provisional" class="badge rounded-pill o_vet_event_new">To register</span>
            </div>
            <div t-if="(vetCard.owner and r.vet_card_owner) or (vetCard.phone and r.vet_card_phone)" class="o_vet_event_line">
                <t t-if="vetCard.owner and r.vet_card_owner"><i class="fa fa-user me-1" title="Owner"/><t t-esc="r.vet_card_owner"/></t>
                <t t-if="vetCard.phone and r.vet_card_phone"><i class="fa fa-phone ms-2 me-1" title="Phone"/><t t-esc="r.vet_card_phone"/></t>
            </div>
            <div t-if="vetCard.veterinarian and r.vet_veterinarian_id" class="o_vet_event_line">
                <i class="fa fa-user-md me-1" title="Veterinarian"/><t t-esc="r.vet_veterinarian_id[1]"/>
            </div>
            <div t-if="vetCard.reason and (r.vet_reason or r.vet_appointment_type_id)" class="o_vet_event_line o_vet_event_reason">
                <t t-if="r.vet_appointment_type_id" t-esc="r.vet_appointment_type_id[1]"/>
                <t t-if="r.vet_reason and r.vet_appointment_type_id">: </t>
                <t t-if="r.vet_reason" t-esc="r.vet_reason"/>
            </div>
            <div t-if="vetCard.alerts and r.vet_card_danger_alert" class="o_vet_event_line o_vet_event_alert_text">
                <i class="fa fa-exclamation-triangle me-1" title="Alerts"/><t t-esc="r.vet_card_danger_alert"/>
            </div>
            <div t-if="vetCard.alerts and r.vet_card_warning_alert" class="o_vet_event_line o_vet_event_warning_text">
                <i class="fa fa-exclamation-circle me-1" title="Alerts"/><t t-esc="r.vet_card_warning_alert"/>
            </div>
            <div t-if="vetCard.alerts and r.vet_card_info_alert" class="o_vet_event_line o_vet_event_info_text">
                <i class="fa fa-info-circle me-1" title="Alerts"/><t t-esc="r.vet_card_info_alert"/>
            </div>
            <!-- top right corner: face of the animal (and the status in the day view) -->
            <span class="o_vet_event_corner">
                <span t-if="vetCard.status and r.vet_card_status_label" class="o_vet_event_status" t-esc="r.vet_card_status_label"/>
                <img t-if="vetCard.species and r.vet_card_species_icon" class="o_vet_event_species_icon" t-att-src="r.vet_card_species_icon" t-att-alt="r.vet_card_species" t-att-title="r.vet_card_species"/>
            </span>
        </div>
    </t>

    <!-- popover of the appointment: "Register Patient" after the title (phone booking not registered yet) -->
    <t t-name="odossey_veterinary.VetCalendarCommonPopover.popover">
        <div class="card-header d-flex justify-content-between align-items-center py-2 pe-2">
            <span class="popover-header d-flex align-items-center border-0 text-truncate">
                <i t-if="props.record.titleIcon" t-attf-class="me-2 {{props.record.titleIcon}}"/>
                <span class="text-truncate" t-esc="props.record.title" t-att-data-tooltip="props.record.title"/>
                <t t-call="odossey_veterinary.VetCalendarRegisterPatientButton">
                    <t t-set="extra_class" t-value="'btn-sm ms-2 flex-shrink-0'"/>
                </t>
            </span>
            <span class="o_cw_popover_close ms-4 mt-2 me-2" t-on-click.stop="() => props.close()">
                <i class="fc-close fc-icon fc-icon-x" />
            </span>
        </div>
        <div class="o_cw_body">
            <!-- patient alerts by severity, as in the consultation header -->
            <div t-foreach="vetAlerts" t-as="alert" t-key="alert.key"
                 t-attf-class="alert alert-{{ alert.key }} o_vet_popover_alert d-flex align-items-baseline gap-2 rounded-0 border-0 mb-0 py-1 px-3"
                 role="alert">
                <i t-attf-class="fa {{ alert.icon }}" t-att-title="alert.text"/>
                <span t-esc="alert.text"/>
            </div>
            <t t-call="{{ constructor.subTemplates.body }}" />
            <div t-if="hasFooter" class="card-footer d-flex gap-1 border-top">
                <t t-call="{{ constructor.subTemplates.footer }}" />
            </div>
        </div>
    </t>

    <t t-name="odossey_veterinary.VetCalendarRegisterPatientButton">
        <a t-if="canRegisterPatient" href="#" t-attf-class="btn btn-success o_vet_popover_register_patient {{ extra_class or '' }}"
           t-on-click.prevent="onRegisterPatient" title="Register Patient">
            <i class="fa fa-user-plus me-1"/>Register Patient
        </a>
    </t>

    <!-- footer: Edit, Start Consultation ... Delete on the far right (away from Start Consultation) -->
    <t t-name="odossey_veterinary.VetCalendarCommonPopover.footer">
        <t t-if="isEventEditable or isEventViewable">
            <a href="#" class="btn btn-primary o_cw_popover_edit" t-on-click="onEditEvent">
                <t t-if="isEventEditable">Edit</t>
                <t t-else="">View</t>
            </a>
        </t>
        <a t-if="canStartConsultation" href="#" class="btn btn-primary o_vet_popover_start_consultation"
           t-on-click.prevent="onStartConsultation">
            <i class="fa fa-stethoscope me-1"/>Start Consultation
        </a>
        <!-- phones: the popover is a dialog without the header above -->
        <t t-if="env.isSmall" t-call="odossey_veterinary.VetCalendarRegisterPatientButton"/>
        <t t-if="isEventDeletable">
            <a href="#" class="btn btn-secondary o_cw_popover_delete ms-auto" t-on-click="onDeleteEvent" title="Delete"><i class="fa fa-trash"/></a>
        </t>
    </t>

    <t t-name="odossey_veterinary.VetSlotDateTimeField">
        <DateTimeField t-props="fieldProps"/>
    </t>

</templates>
