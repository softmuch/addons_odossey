<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_hospitalization_view_form" model="ir.ui.view">
        <field name="name">vet.hospitalization.form</field>
        <field name="model">vet.hospitalization</field>
        <field name="arch" type="xml">
            <form string="Hospitalization">
                <header>
                    <button name="action_schedule_treatment" type="object" string="Schedule Treatment" class="btn-primary"
                            invisible="state != 'admitted'"/>
                    <button name="action_discharge" type="object" string="Discharge" invisible="state != 'admitted'"
                            confirm="Discharge the patient? Pending future tasks are removed and the stay is charged."/>
                    <button name="action_print_discharge" type="object" string="Discharge Summary" invisible="state != 'discharged'"/>
                    <button name="action_reopen" type="object" string="Readmit" invisible="state != 'discharged' or sale_order_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'admitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="admitted,discharged"/>
                </header>
                <div class="alert alert-danger mb-0 d-flex align-items-center flex-wrap gap-2" role="alert" invisible="not pet_has_danger_alert">
                    <i class="fa fa-exclamation-triangle" title="Alert"/>
                    <field name="pet_alert_summary" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not isolation">
                    <i class="fa fa-exclamation-circle me-2" title="Isolation"/>Isolation: use protective equipment.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Sale Order</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="pet_id" options="{'no_create': True}" readonly="state != 'admitted'"/>
                            <field name="owner_id"/>
                            <field name="reason"/>
                            <field name="cage"/>
                            <field name="isolation"/>
                            <field name="diet"/>
                        </group>
                        <group>
                            <field name="admission_date"/>
                            <field name="discharge_date" invisible="state == 'admitted'"/>
                            <field name="days"/>
                            <field name="vet_id" options="{'no_create': True}"/>
                            <field name="day_product_id"/>
                            <field name="consultation_id" readonly="1" invisible="not consultation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatment Sheet" name="tasks">
                            <field name="task_ids" context="{'default_hospitalization_id': id}">
                                <list editable="bottom" decoration-danger="is_overdue" decoration-muted="state == 'skipped'"
                                      decoration-success="state == 'done'">
                                    <field name="scheduled_at"/>
                                    <field name="task_type"/>
                                    <field name="name"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="dose" optional="show"/>
                                    <field name="route" optional="hide"/>
                                    <field name="quantity" optional="hide"/>
                                    <field name="temperature" optional="show"/>
                                    <field name="heart_rate" optional="hide"/>
                                    <field name="respiratory_rate" optional="hide"/>
                                    <field name="note" optional="show"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'pending'"/>
                                    <field name="done_by_id" optional="show"/>
                                    <field name="done_at" optional="hide"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <field name="chargeable" optional="hide"/>
                                    <button name="action_done" type="object" icon="fa-check" title="Done" invisible="state != 'pending'"/>
                                    <button name="action_skip" type="object" icon="fa-times" title="Skip" invisible="state != 'pending'"/>
                                    <button name="action_reset" type="object" icon="fa-undo" title="Reset" invisible="state == 'pending'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discharge Summary" name="discharge">
                            <field name="discharge_summary" placeholder="Evolution, treatments received, indications for home, next check-up..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vet_hospitalization_view_kanban" model="ir.ui.view">
        <field name="name">vet.hospitalization.kanban</field>
        <field name="model">vet.hospitalization</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="overdue_task_count"/>
                <field name="pending_task_count"/>
                <field name="pet_has_danger_alert"/>
                <field name="isolation"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="pet_id" class="fw-bold fs-5"/>
                            <field name="cage" class="badge rounded-pill text-bg-secondary"/>
                        </div>
                        <field name="reason" class="text-muted"/>
                        <div class="d-flex gap-1 flex-wrap mt-1">
                            <span t-if="record.pet_has_danger_alert.raw_value" class="badge rounded-pill text-bg-danger">Alert</span>
                            <span t-if="record.isolation.raw_value" class="badge rounded-pill text-bg-warning">Isolation</span>
                            <span t-if="record.overdue_task_count.raw_value" class="badge rounded-pill text-bg-danger">
                                <t t-esc="record.overdue_task_count.value"/> overdue
                            </span>
                        </div>
                        <footer>
                            <span><field name="days"/> d</span>
                            <field name="vet_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vet_hospitalization_view_list" model="ir.ui.view">
        <field name="name">vet.hospitalization.list</field>
        <field name="model">vet.hospitalization</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'admitted'">
                <field name="name"/>
                <field name="pet_id"/>
                <field name="owner_id"/>
                <field name="cage"/>
                <field name="reason"/>
                <field name="admission_date"/>
                <field name="discharge_date" optional="show"/>
                <field name="days"/>
                <field name="vet_id"/>
                <field name="state" widget="badge" decoration-info="state == 'admitted'" decoration-success="state == 'discharged'"/>
            </list>
        </field>
    </record>

    <record id="vet_hospitalization_view_search" model="ir.ui.view">
        <field name="name">vet.hospitalization.search</field>
        <field name="model">vet.hospitalization</field>
        <field name="arch" type="xml">
            <search>
                <field name="pet_id"/>
                <field name="owner_id"/>
                <field name="cage"/>
                <filter string="Admitted" name="admitted" domain="[('state', '=', 'admitted')]"/>
                <filter string="Discharged" name="discharged" domain="[('state', '=', 'discharged')]"/>
            </search>
        </field>
    </record>

    <record id="vet_hospitalization_action" model="ir.actions.act_window">
        <field name="name">Hospitalization</field>
        <field name="res_model">vet.hospitalization</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_admitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No patient admitted</p>
            <p>Admit a patient from its consultation; plan its treatments by hour and tick them as they are done.</p>
        </field>
    </record>

    <!-- Treatment board: every task of the admitted patients -->
    <record id="vet_hospitalization_task_view_list" model="ir.ui.view">
        <field name="name">vet.hospitalization.task.list</field>
        <field name="model">vet.hospitalization.task</field>
        <field name="arch" type="xml">
            <list string="Treatment Board" create="0" decoration-danger="is_overdue" decoration-success="state == 'done'"
                  decoration-muted="state == 'skipped'">
                <field name="scheduled_at"/>
                <field name="pet_id"/>
                <field name="cage"/>
                <field name="task_type"/>
                <field name="name"/>
                <field name="dose"/>
                <field name="note" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'pending'"/>
                <field name="done_by_id" optional="show"/>
                <field name="is_overdue" column_invisible="1"/>
                <button name="action_done" type="object" icon="fa-check" title="Done" invisible="state != 'pending'"/>
                <button name="action_skip" type="object" icon="fa-times" title="Skip" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="vet_hospitalization_task_view_search" model="ir.ui.view">
        <field name="name">vet.hospitalization.task.search</field>
        <field name="model">vet.hospitalization.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="pet_id"/>
                <field name="name"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Until Tomorrow" name="until_tomorrow" domain="[('scheduled_at', '&lt;=', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <group>
                    <filter string="Patient" name="group_pet" context="{'group_by': 'pet_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vet_hospitalization_task_action" model="ir.actions.act_window">
        <field name="name">Treatment Board</field>
        <field name="res_model">vet.hospitalization.task</field>
        <field name="view_mode">list</field>
        <field name="domain">[('hospitalization_state', '=', 'admitted')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="vet_hospitalization_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">vet.hospitalization.schedule.wizard.form</field>
        <field name="model">vet.hospitalization.schedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="hospitalization_id" invisible="1"/>
                        <field name="kind"/>
                        <field name="product_id"/>
                        <field name="name" placeholder="Defaults to the product name"/>
                        <field name="dose"/>
                        <field name="quantity"/>
                    </group>
                    <group>
                        <field name="start"/>
                        <field name="every_hours"/>
                        <field name="duration_days"/>
                    </group>
                </group>
                <footer>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
