<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ PATIENT -->
    <record id="vet_pet_view_form" model="ir.ui.view">
        <field name="name">vet.pet.form</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_new_consultation" type="object" string="New Consultation" class="btn-primary"
                            invisible="deceased" groups="odossey_veterinary.group_vet_veterinarian"/>
                    <button name="action_new_appointment" type="object" string="Book Appointment" invisible="deceased"/>
                    <button name="action_print_vaccination_card" type="object" string="Vaccination Card"/>
                    <button name="action_whatsapp_owner" type="object" string="WhatsApp Owner" icon="fa-whatsapp"
                            invisible="not owner_phone"/>
                </header>
                <div class="alert alert-danger mb-0 d-flex align-items-center flex-wrap gap-2" role="alert" invisible="not has_danger_alert">
                    <i class="fa fa-exclamation-triangle" title="Alert"/>
                    <strong>Alert:</strong> <field name="alert_summary" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0 d-flex align-items-center flex-wrap gap-2" role="alert" invisible="has_danger_alert or not alert_summary">
                    <i class="fa fa-info-circle" title="Alert"/>
                    <field name="alert_summary" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-secondary mb-0" role="alert" invisible="not deceased">
                    <i class="fa fa-heart-o me-2" title="Deceased"/>Deceased on <field name="date_of_death" readonly="1" class="d-inline"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_consultations" type="object" class="oe_stat_button" icon="fa-stethoscope">
                            <field name="consultation_count" widget="statinfo" string="Consultations"/>
                        </button>
                        <button name="action_view_vaccinations" type="object" class="oe_stat_button" icon="fa-shield">
                            <field name="vaccination_count" widget="statinfo" string="Vaccines"/>
                        </button>
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_view_prescriptions" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                groups="odossey_veterinary.group_vet_veterinarian">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                        <button name="action_view_hospitalizations" type="object" class="oe_stat_button" icon="fa-bed"
                                groups="odossey_veterinary.group_vet_veterinarian">
                            <field name="hospitalization_count" widget="statinfo" string="Hospitalizations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Deceased" bg_color="text-bg-secondary" invisible="not deceased"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active or deceased"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Firulais"/></h1>
                        <h3 class="text-muted"><field name="ref" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="owner_id" context="{'res_partner_search_mode': 'customer'}"/>
                            <field name="owner_phone" widget="phone" invisible="not owner_phone"/>
                            <field name="species_id" options="{'no_create': True}"/>
                            <field name="breed_id" options="{'no_create': True}" invisible="not species_id"/>
                            <field name="sex"/>
                            <field name="neutered"/>
                            <field name="neutered_date" invisible="not neutered"/>
                            <field name="coat"/>
                        </group>
                        <group string="Age &amp; Weight">
                            <field name="birthdate"/>
                            <field name="birthdate_estimated" invisible="not birthdate"/>
                            <field name="age" invisible="not birthdate"/>
                            <label for="weight"/>
                            <div class="o_row">
                                <field name="weight" class="oe_inline"/> kg
                                <span class="text-muted" invisible="not weight_date">(<field name="weight_date" class="oe_inline"/>)</span>
                            </div>
                            <field name="microchip" placeholder="15 digits"/>
                            <field name="vaccination_state" widget="badge"
                                   decoration-success="vaccination_state == 'up_to_date'"
                                   decoration-warning="vaccination_state == 'due_soon'"
                                   decoration-danger="vaccination_state == 'overdue'"/>
                            <field name="next_preventive_date" invisible="not next_preventive_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alerts &amp; Handling" name="alerts">
                            <group>
                                <group>
                                    <field name="temperament" widget="badge"
                                           decoration-success="temperament == 'calm'"
                                           decoration-warning="temperament in ('nervous', 'fearful')"
                                           decoration-danger="temperament == 'aggressive'"/>
                                    <field name="alert_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="chronic_condition_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="allergy_notes" placeholder="e.g. Penicillin, chicken protein..."/>
                                    <field name="handling_notes" placeholder="e.g. Muzzle before handling, calm with treats..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Weight" name="weight">
                            <field name="weight_ids">
                                <list editable="top">
                                    <field name="date"/>
                                    <field name="weight"/>
                                    <field name="body_condition"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vaccination &amp; Parasite Control" name="preventive">
                            <field name="vaccination_ids" readonly="1">
                                <list decoration-danger="state == 'overdue'" decoration-warning="state == 'due_soon'" decoration-muted="state == 'done'">
                                    <field name="date"/>
                                    <field name="preventive_type"/>
                                    <field name="product_id"/>
                                    <field name="lot_name"/>
                                    <field name="next_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'up_to_date'"
                                           decoration-warning="state == 'due_soon'"
                                           decoration-danger="state == 'overdue'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information" name="other">
                            <group>
                                <group>
                                    <field name="tattoo"/>
                                    <field name="pedigree"/>
                                    <field name="blood_type"/>
                                    <field name="insurance"/>
                                    <field name="diet"/>
                                </group>
                                <group>
                                    <field name="deceased"/>
                                    <field name="date_of_death" invisible="not deceased"/>
                                    <field name="cause_of_death" invisible="not deceased"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vet_pet_view_list" model="ir.ui.view">
        <field name="name">vet.pet.list</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <list string="Patients" decoration-muted="deceased" decoration-danger="has_danger_alert">
                <field name="ref"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="owner_phone" optional="show"/>
                <field name="species_id"/>
                <field name="breed_id" optional="show"/>
                <field name="sex" optional="show"/>
                <field name="age" optional="show"/>
                <field name="weight" optional="hide"/>
                <field name="microchip" optional="hide"/>
                <field name="vaccination_state" widget="badge" optional="show"
                       decoration-success="vaccination_state == 'up_to_date'"
                       decoration-warning="vaccination_state == 'due_soon'"
                       decoration-danger="vaccination_state == 'overdue'"/>
                <field name="has_danger_alert" column_invisible="1"/>
                <field name="deceased" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="vet_pet_view_kanban" model="ir.ui.view">
        <field name="name">vet.pet.kanban</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="has_danger_alert"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Photo"/>
                        </aside>
                        <main class="ps-2">
                            <div class="d-flex align-items-center gap-1">
                                <field name="name" class="fw-bold fs-5"/>
                                <i class="fa fa-exclamation-triangle text-danger" t-if="record.has_danger_alert.raw_value" title="Alert"/>
                            </div>
                            <field name="ref" class="text-muted small"/>
                            <div><field name="species_id"/> <span t-if="record.breed_id.raw_value">· <field name="breed_id"/></span></div>
                            <div class="text-muted"><i class="fa fa-user me-1" title="Owner"/><field name="owner_id"/></div>
                            <footer>
                                <field name="age"/>
                                <field name="vaccination_state" widget="badge"
                                       decoration-success="vaccination_state == 'up_to_date'"
                                       decoration-warning="vaccination_state == 'due_soon'"
                                       decoration-danger="vaccination_state == 'overdue'"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vet_pet_view_search" model="ir.ui.view">
        <field name="name">vet.pet.search</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('microchip', 'ilike', self), ('owner_id', 'ilike', self)]"/>
                <field name="owner_id"/>
                <field name="species_id"/>
                <field name="breed_id"/>
                <field name="microchip"/>
                <filter string="Dogs" name="dogs" domain="[('species_id.code', '=', 'DOG')]"/>
                <filter string="Cats" name="cats" domain="[('species_id.code', '=', 'CAT')]"/>
                <separator/>
                <filter string="Vaccines Overdue" name="overdue" domain="[('vaccination_state', '=', 'overdue')]"/>
                <filter string="Vaccines Due Soon" name="due_soon" domain="[('vaccination_state', '=', 'due_soon')]"/>
                <filter string="With Alerts" name="alerts" domain="[('has_danger_alert', '=', True)]"/>
                <separator/>
                <filter string="Deceased" name="deceased" domain="[('deceased', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Species" name="group_species" context="{'group_by': 'species_id'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vet_pet_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">vet.pet</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first patient</p>
            <p>Each patient has an owner, a clinical record number, weight history, alerts and its full medical record.</p>
        </field>
    </record>

    <!-- ============================================================ OWNER -->
    <record id="res_partner_view_form_vet" model="ir.ui.view">
        <field name="name">res.partner.form.vet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_vet_view_pets" type="object" class="oe_stat_button" icon="fa-paw"
                        groups="odossey_veterinary.group_vet_reception">
                    <field name="vet_pet_count" widget="statinfo" string="Pets"/>
                </button>
            </div>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Pets" name="vet_pets" groups="odossey_veterinary.group_vet_reception" invisible="is_company">
                    <field name="vet_pet_ids" context="{'default_owner_id': id}">
                        <list>
                            <field name="ref"/>
                            <field name="name"/>
                            <field name="species_id"/>
                            <field name="breed_id"/>
                            <field name="age"/>
                            <field name="vaccination_state" widget="badge"
                                   decoration-success="vaccination_state == 'up_to_date'"
                                   decoration-warning="vaccination_state == 'due_soon'"
                                   decoration-danger="vaccination_state == 'overdue'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
