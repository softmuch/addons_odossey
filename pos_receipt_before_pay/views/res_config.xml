<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_receipt_before_pay_config_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                    <setting>
                        <field name="pos_receipt_before_pay" />
                    </setting>
            </xpath>
        </field>
    </record>

</odoo>