<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('header-row')]" position="inside">
            <div class="col narrow" name="more"></div>
        </xpath>
        <xpath expr="//div[hasclass('order-row')]" position="inside">
            <div class="col narrow" name="more">
                <button t-if="order.is_split" class="bg-white border-0" t-on-click.stop="() => this.onViewMore(order)">Split Status</button>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('mobileOrderList')]/div[@class='col p-2']" position="inside">
            <div class="col narrow" name="more">
                <button t-if="order.is_split" class="border-0 w-100 p-1 mt-1" t-on-click.stop="() => this.onViewMore(order)">Split Status</button>
            </div>
        </xpath>
    </t>
</templates>
