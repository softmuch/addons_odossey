<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="TipScreen" t-inherit="pos_restaurant.TipScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('top-content')]/button[1]" position="replace">
            <button class="button btn btn-lg btn-outline-primary" t-on-click="() => this.goBack()">
                <i class="fa fa-angle-double-left me-2"/>
                <span>Back</span>
            </button>
        </xpath>
    </t>
</templates>