<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_pricelist_item_form_view_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.reference.currency</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="fixed_price" position="attributes">
                <attribute name="options">{'currency_field': 'fixed_price_currency_id', 'field_digits': True}</attribute>
            </field>
            <xpath expr="//field[@name='fixed_price']/.." position="after">
                <field name="fixed_price_currency_id" invisible="1"/>
                <field name="activate_reference_currency"
                    invisible="compute_price != 'fixed'"/>
                <field name="reference_currency_id"
                    invisible="compute_price != 'fixed' or not activate_reference_currency"
                    required="compute_price == 'fixed' and activate_reference_currency"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_tree_view_from_product_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.item.list.from.product.inherit.reference.currency</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view_from_product"/>
        <field name="arch" type="xml">
            <field name="fixed_price" position="attributes">
                <attribute name="options">{'currency_field': 'fixed_price_currency_id', 'field_digits': True}</attribute>
            </field>
            <field name="fixed_price" position="after">
                <field name="fixed_price_currency_id" column_invisible="True"/>
                <field name="activate_reference_currency" optional="hide"/>
                <field name="reference_currency_id"
                    optional="hide"
                    invisible="not activate_reference_currency"
                    required="activate_reference_currency"/>
            </field>
        </field>
    </record>

</odoo>
